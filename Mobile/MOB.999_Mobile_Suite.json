{
    "test_name": "MOB.999_Mobile_Suite",
    "details": {
        "name": "MOB.999_Mobile_Suite",
        "type": "browser",
        "status": "paused",
        "message": "`MOB.999` Mobile suite (dev) - runs every mobile route check on a mobile viewport.\n- Logs in once, then chains each MOB.1xx route subtest plus the MOB.900 guard.\n- subtestPublicId values are PENDING-WIRE-UP until the children are thrown; see wire_suite.py.",
        "tags": [
            "Mobile",
            "env:dev",
            "E2E",
            "Suite"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                },
                {
                    "id": "87b53e00-1675-4aa6-82c3-6e328e007d4b",
                    "name": "DATA_DOG_EMAIL",
                    "type": "global"
                },
                {
                    "id": "9c503d08-e175-464a-aa8e-dc9c0087ce30",
                    "name": "DATA_DOG_PASSWORD",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                },
                {
                    "id": "87b53e00-1675-4aa6-82c3-6e328e007d4b",
                    "name": "DATA_DOG_EMAIL",
                    "type": "global"
                },
                {
                    "id": "9c503d08-e175-464a-aa8e-dc9c0087ce30",
                    "name": "DATA_DOG_PASSWORD",
                    "type": "global"
                }
            ],
            "set_cookie": ""
        },
        "options": {
            "device_ids": [
                "chrome.tablet"
            ],
            "disable_cors": false,
            "disable_csp": false,
            "ignore_server_certificate_error": false,
            "min_failure_duration": 0,
            "min_location_failed": 1,
            "monitor_options": {},
            "no_screenshot": false,
            "retry": {
                "count": 1,
                "interval": 300.0
            },
            "rum_settings": {
                "is_enabled": false
            },
            "tick_every": 86400
        },
        "steps": [
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to mobile app",
                "noScreenshot": false,
                "params": {
                    "value": "{{ MOBDEV }}"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Type email",
                "noScreenshot": false,
                "params": {
                    "value": "{{ DATA_DOG_EMAIL }}",
                    "element": {
                        "url": "https://dev.mentorapm.com/login",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//input[@name=\"email\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "typeText"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Click \"Next\"",
