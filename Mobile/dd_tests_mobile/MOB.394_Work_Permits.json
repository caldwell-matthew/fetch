{
    "test_name": "MOB.394_Work_Permits",
    "details": {
        "name": "MOB.394_Work_Permits",
        "type": "browser",
        "status": "paused",
        "message": "`MOB.394` The **Permits** tab renders its real permit content.\n- READ-ONLY. Permits are read-only data in mobile (repo owner, 2026-08-12) \u2014 the tab\n  displays them; approving happens elsewhere.\n- **Unlike Warranties, `PermitsStats` has no empty state.** With no permits it renders an\n  empty fragment \u2014 a blank panel with nothing to assert. This test is only meaningful\n  because the fixture now carries a real permit; if that is ever removed, this fails and\n  the cause is fixture data, not code.\n- Requires **all three** labels (`Status:`, `Expiration Date:`, `Approved By:`) rather\n  than any one of them, so a partially-rendered card cannot pass.",
        "tags": [
            "Mobile",
            "env:dev",
            "Work Order",
            "read-only"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "set_cookie": ""
        },
        "options": {
            "device_ids": [
                "chrome.tablet"
            ],
            "disable_cors": false,
            "disable_csp": false,
            "ignore_server_certificate_error": false,
            "min_failure_duration": 0,
            "min_location_failed": 1,
            "monitor_options": {},
            "no_screenshot": false,
            "retry": {
                "count": 1,
                "interval": 300.0
            },
            "rum_settings": {
                "is_enabled": false
            },
            "tick_every": 86400
        },
        "steps": [
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to /work to warm the lookup cache",
                "noScreenshot": false,
                "params": {
                    "value": "https://dev.mentorapm.com/apm-mobile/work"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the work list and lookup prefetch",
                "noScreenshot": false,
                "params": {
                    "value": 20
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to the fixture work order",
                "noScreenshot": false,
                "params": {
                    "value": "https://dev.mentorapm.com/apm-mobile/work/EYRpYJ9QYdQ1JFF10JtB0Q"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the detail view to render",
                "noScreenshot": false,
                "params": {
                    "value": 5
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Test work order detail rendered",
                "noScreenshot": false,
                "params": {
                    "value": "Status:"
                },
                "type": "assertPageContains"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Open the \"Permits\" tab",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work/EYRpYJ9QYdQ1JFF10JtB0Q",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[@role=\"tab\"][normalize-space(.)=\"Permits\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "click"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the panel",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The \"Permits\" tab is active",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work/EYRpYJ9QYdQ1JFF10JtB0Q",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[@role=\"tab\"][normalize-space(.)=\"Permits\"][@data-active]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementPresent"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "PROOF: a permit card rendered with its status, expiration and approver",
                "noScreenshot": false,
                "params": {
                    "code": "\nconst t = document.body.innerText || '';\nreturn t.indexOf('Status:') !== -1\n    && t.indexOf('Expiration Date:') !== -1\n    && t.indexOf('Approved By:') !== -1;\n"
                },
                "type": "assertFromJavascript"
            }
        ]
    }
}