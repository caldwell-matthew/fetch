{
    "test_name": "MOB.560_AssetVerify_Counts_Badges",
    "details": {
        "name": "MOB.560_AssetVerify_Counts_Badges",
        "type": "browser",
        "status": "paused",
        "message": "`MOB.560` Job-list counts, status badges, and the ring chart's numeric labels.\n- READ-ONLY. Selecting a status badge is component state (`selectedStatus`); nothing is\n  written and nothing persists.\n- **Asserts the numeric label, never the SVG.** The ring is a Mantine `RingProgress` \u2014\n  arcs and colours are not text. Its legend (`Ready: n`, `In Progress: n`, \u2026) is.\n- **Invariant 1 \u2014 arithmetic.** Every job card's `X out of Y Assets Verified` must agree\n  with its `Z%`, where `Z = Math.round(X/Y*100)` and `Y = 0` gives `0` (the component\n  ends in `|| 0` to swallow the NaN). Checked across every card in one pass, and it\n  requires at least one match so it cannot pass vacuously on an empty list (trap 5).\n- **Invariant 2 \u2014 the badge actually filters.** `In Progress` keeps the fixture job;\n  `Completed` must hide it. The negative leg is the proof \u2014 a badge that only\n  highlighted itself would satisfy the positive one.\n- Not asserted: legend count vs. number of rendered cards. Job cards are `<Paper>` with\n  no distinguishing class or test id, so counting them would mean guessing a selector,\n  and a wrong selector yields a confident wrong answer instead of an error.",
        "tags": [
            "Mobile",
            "env:dev",
            "Asset Verification",
            "read-only"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "set_cookie": ""
        },
        "options": {
            "device_ids": [
                "chrome.tablet"
            ],
            "disable_cors": false,
            "disable_csp": false,
            "ignore_server_certificate_error": false,
            "min_failure_duration": 0,
            "min_location_failed": 1,
            "monitor_options": {},
            "no_screenshot": false,
            "retry": {
                "count": 1,
                "interval": 300.0
            },
            "rum_settings": {
                "is_enabled": false
            },
            "tick_every": 86400
        },
        "steps": [
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to the mobile job list",
                "noScreenshot": false,
                "params": {
                    "value": "https://dev.mentorapm.com/apm-mobile/asset-verify"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the page to mount",
                "noScreenshot": false,
                "params": {
                    "value": 10
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Test the \"Mobile Jobs\" page mounted",
                "noScreenshot": false,
                "params": {
                    "check": "contains",
                    "value": "Mobile Jobs",
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-verify",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[@id=\"page-title\"]//h4[contains(normalize-space(.), \"Mobile Jobs\")]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementContent"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the lookup prefetch and batched detail downloads",
                "noScreenshot": false,
                "params": {
                    "value": 25
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Test the job list rendered",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-verify",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//input[@placeholder=\"Find Mobile Job(s)\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementPresent"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Test the batched job-detail downloads finished",
                "noScreenshot": false,
                "params": {
                    "value": "Fetching mobile job details"
                },
                "type": "assertPageLacks"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "FIXTURE GUARD: \"DATADOG MOBILE JOB\" is in this crew's list",
                "noScreenshot": false,
                "params": {
                    "value": "DATADOG MOBILE JOB"
                },
                "type": "assertPageContains"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The status ring's legend renders an In Progress count",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-verify",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//li[contains(normalize-space(.), \"In Progress:\")]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementPresent"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The status ring's legend renders a Completed count",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-verify",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//li[contains(normalize-space(.), \"Completed:\")]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementPresent"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "PROOF: every card's % label matches its own X-out-of-Y counts",
                "noScreenshot": false,
                "params": {
                    "code": "\nconst t = document.body.innerText || '';\nconst re = /(\\d+)\\s+out of\\s+(\\d+)\\s+Assets Verified\\s*(\\d+)%/g;\nlet m, n = 0;\nwhile ((m = re.exec(t)) !== null) {\n  n++;\n  const verified = +m[1], total = +m[2], pct = +m[3];\n  const expected = total === 0 ? 0 : Math.round(verified / total * 100);\n  if (pct !== expected) return false;\n}\nreturn n > 0;\n"
                },
                "type": "assertFromJavascript"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Select the In Progress status badge",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-verify",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//li[contains(normalize-space(.), \"In Progress:\")]"
                                }
                            ]
                        }
                    }
                },
                "type": "click"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the list to re-filter",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "\"DATADOG MOBILE JOB\" is IN_PROGRESS, so it survives the In Progress badge",
                "noScreenshot": false,
                "params": {
                    "value": "DATADOG MOBILE JOB"
                },
                "type": "assertPageContains"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The % labels still match after filtering",
                "noScreenshot": false,
                "params": {
                    "code": "\nconst t = document.body.innerText || '';\nconst re = /(\\d+)\\s+out of\\s+(\\d+)\\s+Assets Verified\\s*(\\d+)%/g;\nlet m, n = 0;\nwhile ((m = re.exec(t)) !== null) {\n  n++;\n  const verified = +m[1], total = +m[2], pct = +m[3];\n  const expected = total === 0 ? 0 : Math.round(verified / total * 100);\n  if (pct !== expected) return false;\n}\nreturn n > 0;\n"
                },
                "type": "assertFromJavascript"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Deselect the In Progress badge (it toggles)",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-verify",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//li[contains(normalize-space(.), \"In Progress:\")]"
                                }
                            ]
                        }
                    }
                },
                "type": "click"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the list to restore",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Select the Completed status badge",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-verify",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//li[contains(normalize-space(.), \"Completed:\")]"
                                }
                            ]
                        }
                    }
                },
                "type": "click"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the list to re-filter",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "PROOF: the Completed badge filters \u2014 \"DATADOG MOBILE JOB\" is hidden",
                "noScreenshot": false,
                "params": {
                    "value": "DATADOG MOBILE JOB"
                },
                "type": "assertPageLacks"
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Deselect the Completed badge",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-verify",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//li[contains(normalize-space(.), \"Completed:\")]"
                                }
                            ]
                        }
                    }
                },
                "type": "click"
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the list to restore",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "RESTORED: \"DATADOG MOBILE JOB\" is listed again",
                "noScreenshot": false,
                "params": {
                    "value": "DATADOG MOBILE JOB"
                },
                "type": "assertPageContains"
            }
        ]
    }
