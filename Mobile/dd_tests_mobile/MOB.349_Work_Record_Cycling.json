                                    "type": "xpath",
                                    "value": "(//*[contains(concat(\" \", normalize-space(@class), \" \"), \" mantine-Group-root \")][.//*[@data-icon=\"globe\" or contains(concat(\" \", normalize-space(@class), \" \"), \" fa-globe \")]]//button[.//*[@data-icon=\"circle-arrow-right\" or contains(concat(\" \", normalize-space(@class), \" \"), \" fa-circle-arrow-right \")]])[1]"
