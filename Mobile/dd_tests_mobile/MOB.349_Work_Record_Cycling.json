                                    "type": "xpath",
                                    "value": "//*[contains(concat(\" \", normalize-space(@class), \" \"), \" mantine-Group-root \")][.//*[@data-icon=\"globe\" or contains(concat(\" \", normalize-space(@class), \" \"), \" fa-globe \")]]//button[.//*[@data-icon=\"circle-arrow-left\" or contains(concat(\" \", normalize-space(@class), \" \"), \" fa-circle-arrow-left \")]]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementPresent",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The FORWARD cycle arrow renders",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[contains(concat(\" \", normalize-space(@class), \" \"), \" mantine-Group-root \")][.//*[@data-icon=\"globe\" or contains(concat(\" \", normalize-space(@class), \" \"), \" fa-globe \")]]//button[.//*[@data-icon=\"circle-arrow-right\" or contains(concat(\" \", normalize-space(@class), \" \"), \" fa-circle-arrow-right \")]]"
