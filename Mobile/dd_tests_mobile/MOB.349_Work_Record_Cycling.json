                "params": {
                    "code": "const rows = [...document.querySelectorAll('.mantine-Paper-root')].filter(e => /Description:/.test(e.textContent||''));\nreturn rows.length >= 2;"
                },
                "type": "assertFromJavascript",
                "timeout": 60
