{
    "test_name": "MOB.460_Global_Module_Resync",
    "details": {
        "name": "MOB.460_Global_Module_Resync",
        "type": "browser",
        "status": "paused",
        "message": "`MOB.460` The module-level ResyncButton actually triggers a resync.\n- READ-ONLY. Refetches data; writes nothing.\n- `ResyncButton` renders `Data synced on <timestamp>` and returns `null` when there is\n  no `lastFetched`, so the label's presence is also proof the control exists at all.\n- **Resync leaves no durable observable difference**, so this cannot be an `[x]`. The\n  only signal is a transient loading label (`Fetching mobile job details`), asserted\n  as OPTIONAL. `Fetching data for lookups` was tried first and lost the race; \n  `Fetching mobile job list` never fires here at all \u2014 clearCache does not evict the\n  list query and refetch does not flip `loading`.\n- What IS proven: the control renders with a timestamp, the click does not break the\n  page, and nothing is left hanging.\n- Distinct from MOB.410, which exercises the *menu* ReSync item, not the module one.",
        "tags": [
            "Mobile",
            "env:dev",
            "Chrome",
            "read-only"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "set_cookie": ""
        },
        "options": {
            "device_ids": [
                "chrome.tablet"
            ],
            "disable_cors": false,
            "disable_csp": false,
            "ignore_server_certificate_error": false,
            "min_failure_duration": 0,
            "min_location_failed": 1,
            "monitor_options": {},
            "no_screenshot": false,
            "retry": {
                "count": 1,
                "interval": 300.0
            },
            "rum_settings": {
                "is_enabled": false
            },
            "tick_every": 86400
        },
        "steps": [
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to the mobile job list",
                "noScreenshot": false,
                "params": {
                    "value": "https://dev.mentorapm.com/apm-mobile/asset-verify"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the job list and its prefetch",
                "noScreenshot": false,
                "params": {
                    "value": 30
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Baseline: the prefetch has settled",
                "noScreenshot": false,
                "params": {
                    "value": "Fetching data for lookups"
                },
                "type": "assertPageLacks"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The resync timestamp is rendered",
                "noScreenshot": false,
                "params": {
                    "value": "Data synced on"
                },
                "type": "assertPageContains"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Click the module resync button",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-verify",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//button[.//*[@data-icon=\"sync\" or contains(concat(\" \", normalize-space(@class), \" \"), \" fa-sync \") or @data-icon=\"arrows-rotate\" or contains(concat(\" \", normalize-space(@class), \" \"), \" fa-arrows-rotate \") or @data-icon=\"rotate\" or contains(concat(\" \", normalize-space(@class), \" \"), \" fa-rotate \")]]"
                                }
                            ]
                        }
                    }
                },
                "type": "click"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the list refetch return and the detail download start",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": true,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": false,
                "name": "Resync fired: job details are re-downloading (optional: transient)",
                "noScreenshot": false,
                "params": {
                    "value": "Fetching mobile job details"
                },
                "type": "assertPageContains"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the resync to finish",
                "noScreenshot": false,
                "params": {
                    "value": 30
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Nothing left hanging after the resync",
                "noScreenshot": false,
                "params": {
                    "value": "Fetching mobile job details"
                },
                "type": "assertPageLacks"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The job list still renders after resync",
                "noScreenshot": false,
                "params": {
                    "value": "DATADOG MOBILE JOB"
                },
                "type": "assertPageContains"
            }
        ]
    }
}