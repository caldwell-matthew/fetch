            },
            {
                "allowFailure": true,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "PREMISE: exactly one `Pump 0102 \u00b7 Mounting/Support` card on screen",
                "noScreenshot": false,
                "params": {
                    "code": "const norm = t => (t || '').replace(/\\s+/g, ' ').trim();\nconst cards = [...new Set([...document.querySelectorAll('li')]\n  .filter(li => norm(li.textContent).indexOf('Condition Found:') === 0)\n  .map(li => li.closest('[class*=\"mantine-Paper-root\"]')))].filter(Boolean);\nconst orig = cards.filter(c => {\n  const grp = c.parentElement && c.parentElement.closest('[class*=\"mantine-Paper-root\"]');\n  const a = grp && grp.querySelector('[class*=\"mantine-Text-root\"]');\n  const b = c.querySelector('button');\n  return a && norm(a.textContent) === 'Pump 0102' && b && norm(b.textContent) === 'Mounting/Support';\n});\nreturn orig.length === 1;"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": true,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "PREMISE (server): the Mounting/Support condition holds Condition Left 2 \u2014 the fixed restore value",
                "noScreenshot": false,
                "params": {
                    "code": "const K = \"__dd386_server\", F = K + ':inflight', T = K + ':at';\nconst raw = sessionStorage.getItem(K);\nif (raw) {\n  let ok = false;\n  try { const data = (JSON.parse(raw) || {}).data; ok = !!data && !!(data.workStage.condition.filter(c => c.inspectionElementId && c.inspectionElementId.name === 'Mounting/Support').length === 1 && data.workStage.condition.find(c => c.inspectionElementId && c.inspectionElementId.name === 'Mounting/Support').conditionScore === 2); } catch (e) { ok = false; }\n  if (ok) return true;\n  sessionStorage.removeItem(K);\n}\nif (!sessionStorage.getItem(F) && Date.now() - Number(sessionStorage.getItem(T) || 0) > 2000) {\n  sessionStorage.setItem(F, '1');\n  sessionStorage.setItem(T, String(Date.now()));\n  window.fetch('/graphql', { method: 'POST', credentials: 'same-origin',\n      headers: { 'content-type': 'application/json', 'apollo-require-preflight': '*' },\n      body: JSON.stringify({ query: \"query($id: ID!) { workStage(id: $id) { condition { conditionScore inspectionElementId { name } } } }\", variables: {\"id\": \"EYRpYJ9QYdQ1JFF10JtB0Q\"} }) })\n    .then(r => r.json())\n    .then(j => { sessionStorage.setItem(K, JSON.stringify(j)); sessionStorage.removeItem(F); })\n    .catch(e => { sessionStorage.setItem(K, JSON.stringify({ errors: [String(e)] })); sessionStorage.removeItem(F); });\n}\nreturn false;"
                },
                "type": "assertFromJavascript",
                "timeout": 45
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Remove the server read's sessionStorage keys",
                "noScreenshot": false,
                "params": {
                    "code": "['__dd386_server', '__dd386_server:inflight', '__dd386_server:at'].forEach(k => sessionStorage.removeItem(k));\nreturn true;"
                },
                "type": "assertFromJavascript",
                "timeout": 15
            },
            {
