                "isCritical": true,
                "name": "Click `Edit Item`",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work/EYRpYJ9QYdQ1JFF10JtB0Q",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "(//*[contains(concat(\" \", normalize-space(@class), \" \"), \" mantine-Menu-item \")][normalize-space(.)=\"Edit Item\"])[1]"
                                }
                            ]
                        }
                    }
                },
                "type": "click",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the edit form mount (it loads the WorkStageCondition schema)",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The condition form opened",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work/EYRpYJ9QYdQ1JFF10JtB0Q",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//form[@id=\"work-condition-form\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementPresent",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "\u2b50 PREFILLED from the card: asset, group, element and the three scores",
                "noScreenshot": false,
                "params": {
                    "code": "const want = {\"assetId\": \"Pump 0102\", \"assetStandardDetailId\": \"Structural\", \"inspectionElementId\": \"Mounting/Support\", \"conditionFound\": \"1\", \"conditionScore\": \"2\", \"stressScore\": \"3\"};\nconst got = {};\nfor (const k of Object.keys(want)) { const el = document.getElementById(k); got[k] = el ? (el.value || '').trim() : null; }\nreturn Object.keys(want).every(k => got[k] === want[k]);"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Close the form with Escape \u2014 NEVER submitted",
                "noScreenshot": false,
                "params": {
                    "value": "Escape"
                },
                "type": "pressKey"
            },
            {
