{
    "test_name": "MOB.387_Work_Condition_Edit_Prefill",
    "details": {
        "name": "MOB.387_Work_Condition_Edit_Prefill",
        "type": "browser",
        "status": "paused",
        "message": "`MOB.387` **`Edit Item` opens the condition form filled from its own card.**\n- The fixture's permanent condition (`Pump 0102 \u00b7 Structural \u00b7 Mounting/Support`, 1/2/3):\n  gear \u2192 `Edit Item` \u2192 `#assetId` / `#assetStandardDetailId` / `#inspectionElementId` /\n  `#conditionFound` / `#conditionScore` / `#stressScore` hold exactly the card's values\n  (`ConditionForm`'s `defaultValues`).\n- \ud83d\uded1 **READ-ONLY**: closed with Escape, never submitted; a reload proves the card unchanged.",
        "tags": [
            "Mobile",
            "env:dev",
            "Work Order",
            "Condition",
            "read-only"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "set_cookie": ""
        },
        "options": {
            "device_ids": [
                "chrome.tablet"
            ],
            "disable_cors": false,
            "disable_csp": false,
            "ignore_server_certificate_error": false,
            "min_failure_duration": 0,
            "min_location_failed": 1,
            "monitor_options": {},
            "no_screenshot": false,
            "retry": {
                "count": 1,
                "interval": 300.0
            },
            "rum_settings": {
                "is_enabled": false
            },
            "tick_every": 86400
        },
        "steps": [
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to the fixture work order",
                "noScreenshot": false,
                "params": {
                    "value": "https://dev.mentorapm.com/apm-mobile/work/EYRpYJ9QYdQ1JFF10JtB0Q"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the detail view begin rendering",
                "noScreenshot": false,
                "params": {
                    "value": 2
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Test work order detail rendered",
                "noScreenshot": false,
                "params": {
                    "value": "Status:"
                },
                "type": "assertPageContains",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Open the Condition tab",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work/EYRpYJ9QYdQ1JFF10JtB0Q",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[@role=\"tab\"][contains(normalize-space(.), \"Condition\")]"
                                }
                            ]
                        }
                    }
                },
                "type": "click",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the condition cards render",
                "noScreenshot": false,
                "params": {
                    "value": 2
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "PREMISE: exactly one `Pump 0102 \u00b7 Mounting/Support` card, reading 1 / 2 / 3",
                "noScreenshot": false,
                "params": {
                    "code": "const norm = t => (t || '').replace(/\\s+/g, ' ').trim();\nconst cards = [...new Set([...document.querySelectorAll('li')]\n  .filter(li => norm(li.textContent).indexOf('Condition Found:') === 0)\n  .map(li => li.closest('[class*=\"mantine-Paper-root\"]')))].filter(Boolean);\nconst orig = cards.filter(c => {\n  const grp = c.parentElement && c.parentElement.closest('[class*=\"mantine-Paper-root\"]');\n  const a = grp && grp.querySelector('[class*=\"mantine-Text-root\"]');\n  const b = c.querySelector('button');\n  return a && norm(a.textContent) === 'Pump 0102' && b && norm(b.textContent) === 'Mounting/Support';\n});\nconst lis = orig.length === 1 ? [...orig[0].querySelectorAll('li')].map(li => norm(li.textContent)) : [];\nconst same = ['Condition Found: 1', 'Condition Score: 2', 'Stress Score: 3'].every(v => lis.includes(v));\nreturn orig.length === 1 && same;"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Open that card's gear",
                "noScreenshot": false,
                "params": {
                    "code": "const norm = t => (t || '').replace(/\\s+/g, ' ').trim();\nconst cards = [...new Set([...document.querySelectorAll('li')]\n  .filter(li => norm(li.textContent).indexOf('Condition Found:') === 0)\n  .map(li => li.closest('[class*=\"mantine-Paper-root\"]')))].filter(Boolean);\nconst orig = cards.filter(c => {\n  const grp = c.parentElement && c.parentElement.closest('[class*=\"mantine-Paper-root\"]');\n  const a = grp && grp.querySelector('[class*=\"mantine-Text-root\"]');\n  const b = c.querySelector('button');\n  return a && norm(a.textContent) === 'Pump 0102' && b && norm(b.textContent) === 'Mounting/Support';\n});\nif (orig.length !== 1) return false;\nconst g = orig[0].querySelector('[aria-label=\"Menu\"]');\nif (!g) return false;\ng.click();\nreturn true;"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the menu open",
                "noScreenshot": false,
                "params": {
                    "value": 1
                },
                "type": "wait"
            },
            {
