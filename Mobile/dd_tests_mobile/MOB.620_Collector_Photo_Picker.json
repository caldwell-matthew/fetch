                "name": "\ud83d\uded1 All THREE capture options render (asserted, never clicked)",
                "noScreenshot": false,
                "params": {
                    "code": "const m = [...document.querySelectorAll('.mantine-Modal-content')]\n  .find(x => (x.textContent || '').includes('Select Photo Source'));\nif (!m) return false;\nconst t = [...m.querySelectorAll('button')].map(b => (b.textContent || '').trim());\nreturn t.includes('Take Photo')\n  && t.includes('Take Video')\n  && t.includes('Photo Gallery');"
                },
