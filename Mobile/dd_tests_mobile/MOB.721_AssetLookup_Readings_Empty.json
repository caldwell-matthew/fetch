            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Open its \"Readings\" tab",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-lookup",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "(//*[contains(concat(\" \", normalize-space(@class), \" \"), \" mantine-Accordion-item \")][.//*[contains(concat(\" \", normalize-space(@class), \" \"), \" mantine-Accordion-control \")][contains(., \"Building 0000\")]])[1]//*[@role=\"tab\"][normalize-space(.)=\"Readings\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "click",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the Readings panel render",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The ACTIVE tab of the Building 0000 row is `Readings` (the panel below is its own)",
                "noScreenshot": false,
                "params": {
                    "code": "const items = [...document.querySelectorAll('[class*=\"mantine-Accordion-item\"]')];\nconst it = items.find(i => { const c = i.querySelector('[class*=\"mantine-Accordion-control\"]');\n  return c && (c.textContent || '').includes('Building 0000'); });\nif (!it) return false;\nconst tabEl = it.querySelector('[role=\"tab\"][aria-selected=\"true\"], [role=\"tab\"][data-active]');\nconst byId = tabEl && tabEl.getAttribute('aria-controls')\n  ? document.getElementById(tabEl.getAttribute('aria-controls')) : null;\nconst p = byId || [...it.querySelectorAll('[role=\"tabpanel\"]')].find(x => x.style.display !== 'none');\nif (!p || !tabEl) return false;\nconst t = (p.textContent || '');\nreturn (tabEl.textContent || '').trim() === 'Readings';"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "\u2b50 EMPTY STATE: the panel reads `No readings recorded for this asset.` \u2014 the asset has no readings",
                "noScreenshot": false,
                "params": {
                    "code": "const items = [...document.querySelectorAll('[class*=\"mantine-Accordion-item\"]')];\nconst it = items.find(i => { const c = i.querySelector('[class*=\"mantine-Accordion-control\"]');\n  return c && (c.textContent || '').includes('Building 0000'); });\nif (!it) return false;\nconst tabEl = it.querySelector('[role=\"tab\"][aria-selected=\"true\"], [role=\"tab\"][data-active]');\nconst byId = tabEl && tabEl.getAttribute('aria-controls')\n  ? document.getElementById(tabEl.getAttribute('aria-controls')) : null;\nconst p = byId || [...it.querySelectorAll('[role=\"tabpanel\"]')].find(x => x.style.display !== 'none');\nif (!p || !tabEl) return false;\nconst t = (p.textContent || '');\nreturn t.includes('No readings recorded for this asset.');"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            }
        ]
    }
