{
    "test_name": "MOB.343_Work_List_Search_Filter",
    "details": {
        "name": "MOB.343_Work_List_Search_Filter",
        "type": "browser",
        "status": "paused",
        "message": "`MOB.343` The work list's search box **actually filters the list** (T2.1).\n- READ-ONLY. `inputText` is component state; nothing is written or persisted.\n- **This is the test `MOB.340` should have been.** MOB.340 types a term and asserts the\n  *input* holds it \u2014 which passed for weeks against an empty list\n  (`bugs_found.md` \u00a725) and would still pass if the filter were deleted.\n- **The proof is a row count, read in JS.** The search box, the sort label and the\n  status legend all echo their values into the page, so `assertPageContains` on a\n  search term passes against zero results (trap 5b). Rows have no test hook, so\n  counting them is a JS step.\n- **Both legs are load-bearing.** \"0 rows after a nonsense term\" would also pass if\n  the list never rendered at all; the restore leg is what proves there were rows to\n  filter (trap 5).\n- Asserts no record name, count or status, so it does not need editing when the crew's\n  work list changes.\n- \u26a0\ufe0f The search is debounced 300ms (`useDebouncedState`), so each leg waits before\n  counting.",
        "tags": [
            "Mobile",
            "env:dev",
            "Work Order",
            "Search",
            "read-only"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "set_cookie": ""
        },
        "options": {
            "device_ids": [
                "chrome.tablet"
            ],
            "disable_cors": false,
            "disable_csp": false,
            "ignore_server_certificate_error": false,
            "min_failure_duration": 0,
            "min_location_failed": 1,
            "monitor_options": {},
            "no_screenshot": false,
            "retry": {
                "count": 1,
                "interval": 300.0
            },
            "rum_settings": {
                "is_enabled": false
            },
            "tick_every": 86400
        },
        "steps": [
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to /work \u2014 the work order list",
                "noScreenshot": false,
                "params": {
                    "value": "https://dev.mentorapm.com/apm-mobile/work"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the work list begin rendering",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The \"Work Orders\" page mounted",
                "noScreenshot": false,
                "params": {
                    "check": "contains",
                    "value": "Work Orders",
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[@id=\"page-title\"]//h4[contains(normalize-space(.), \"Work Orders\")]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementContent",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the workstage pages and the lookup prefetch",
                "noScreenshot": false,
                "params": {
                    "value": 20
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The work list rendered its search box",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//input[@placeholder=\"Find Workstage(s)\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementPresent"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "LOADEDALL 1/3: the initial fetch finished",
                "noScreenshot": false,
                "params": {
                    "value": "Retrieving assigned work"
                },
                "type": "assertPageLacks"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "LOADEDALL 2/3: paging through workstages finished",
                "noScreenshot": false,
                "params": {
                    "value": "workstages found"
                },
                "type": "assertPageLacks"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "LOADEDALL 3/3: the per-stage detail downloads finished",
                "noScreenshot": false,
                "params": {
                    "value": "workstages downloaded"
                },
                "type": "assertPageLacks"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "WORK ROW GUARD: at least one work order rendered",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "(//*[contains(concat(\" \", normalize-space(@class), \" \"), \" mantine-Paper-root \")][contains(., \"Description:\")])[1]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementPresent",
                "timeout": 60
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "BASELINE: the unfiltered list has at least one row",
                "noScreenshot": false,
                "params": {
                    "code": "const ROWS = () => [...document.querySelectorAll('.mantine-Paper-root')]\n  .filter(e => (e.textContent || '').includes('Description:'));\nreturn ROWS().length >= 1;"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Focus the search box",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//input[@placeholder=\"Find Workstage(s)\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "click",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Select any existing text (typeText APPENDS without this)",
                "noScreenshot": false,
                "params": {
                    "value": "a",
                    "modifiers": [
                        "Control"
                    ]
                },
                "type": "pressKey"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Type a term nothing can match (\"ZZQXJV0000\")",
                "noScreenshot": false,
                "params": {
                    "value": "ZZQXJV0000",
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//input[@placeholder=\"Find Workstage(s)\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "typeText"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait past the 300ms search debounce",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "PROOF: the list filtered to ZERO rows \u2014 the search really filters",
                "noScreenshot": false,
                "params": {
                    "code": "const ROWS = () => [...document.querySelectorAll('.mantine-Paper-root')]\n  .filter(e => (e.textContent || '').includes('Description:'));\nreturn ROWS().length === 0;"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Focus the search box again",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//input[@placeholder=\"Find Workstage(s)\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "click",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Select the nonsense term",
                "noScreenshot": false,
                "params": {
                    "value": "a",
                    "modifiers": [
                        "Control"
                    ]
                },
                "type": "pressKey"
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Delete it \u2014 restore the unfiltered list",
                "noScreenshot": false,
                "params": {
                    "value": "Delete"
                },
                "type": "pressKey"
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait past the debounce again",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "RESTORED: the rows are back \u2014 so there WERE rows to filter",
                "noScreenshot": false,
                "params": {
                    "code": "const ROWS = () => [...document.querySelectorAll('.mantine-Paper-root')]\n  .filter(e => (e.textContent || '').includes('Description:'));\nreturn ROWS().length >= 1;"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            }
        ]
    }
}