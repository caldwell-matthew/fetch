{
    "test_name": "MOB.320_Work_Status_Update",
    "details": {
        "name": "MOB.320_Work_Status_Update",
        "type": "browser",
        "status": "paused",
        "message": "`MOB.320` Walk the fixture work order through all six statuses, ending on Ready.\n- Sequence: Pending -> In Progress -> On Hold -> Complete -> Canceled -> Ready\n- Always ENDS ON Ready, so the fixture is left in a known state and the test is\n  repeatable. Each transition is verified against the status badge, not just the\n  toast, so a silently-failed mutation is caught.\n- Only the first leg is optional: StatusMenuIcon hides the CURRENT status, so\n  'Mark as Pending' is absent if a previous run left it there. Its assertion still\n  holds in that case.\n- MUTATES the fixture (EYRpYJ9QYdQ1JFF10JtB0Q) only - never real assigned work.\n- Status-notes steps are optional pending confirmation of requireStatusNotes.",
        "tags": [
            "Mobile",
            "env:dev",
            "Work Order",
            "CRUD"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "set_cookie": ""
        },
        "options": {
            "device_ids": [
                "chrome.tablet"
            ],
            "disable_cors": false,
            "disable_csp": false,
            "ignore_server_certificate_error": false,
            "min_failure_duration": 0,
            "min_location_failed": 1,
            "monitor_options": {},
            "no_screenshot": false,
            "retry": {
                "count": 1,
                "interval": 300.0
            },
            "rum_settings": {
                "is_enabled": false
            },
            "tick_every": 86400
        },
