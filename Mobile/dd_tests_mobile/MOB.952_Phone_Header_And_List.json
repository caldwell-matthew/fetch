{
    "test_name": "MOB.952_Phone_Header_And_List",
    "details": {
        "name": "MOB.952_Phone_Header_And_List",
        "type": "browser",
        "status": "paused",
        "message": "`MOB.952` **PHONE WIDTH \u2014 the header and the work list.**\n- The affixed `+` and the list's search control are on screen; the burger is on screen.\n- By design the header crew shortcut `.mobile-crew` is hidden under 450px; the burger's\n  `Switch Crews` is the phone path (optional check \u2014 a design change should not go red).\n- `chrome.mobile_small` ONLY; runs inside `MOB.984_Phone_Suite`. \ud83d\uded1 READ-ONLY.",
        "tags": [
            "Mobile",
            "env:dev",
            "Phone",
            "Work Order",
            "read-only"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "set_cookie": ""
        },
        "options": {
            "device_ids": [
                "chrome.mobile_small"
            ],
            "disable_cors": false,
            "disable_csp": false,
            "ignore_server_certificate_error": false,
            "min_failure_duration": 0,
            "min_location_failed": 1,
            "monitor_options": {},
            "no_screenshot": false,
            "retry": {
                "count": 1,
                "interval": 300.0
            },
            "rum_settings": {
                "is_enabled": false
            },
            "tick_every": 86400
        },
        "steps": [
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to the work list",
                "noScreenshot": false,
                "params": {
                    "value": "https://dev.mentorapm.com/apm-mobile/work"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the work list render",
                "noScreenshot": false,
                "params": {
                    "value": 10
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The \"Work Orders\" page mounted",
                "noScreenshot": false,
                "params": {
                    "value": "Work Orders"
                },
                "type": "assertPageContains",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "DEVICE: PHONE width (`availWidth` < 450 \u2014 under the crew shortcut's breakpoint too)",
                "noScreenshot": false,
                "params": {
                    "code": "const w = window.screen.availWidth;\nreturn w > 0 && w < 450;"
                },
                "type": "assertFromJavascript",
                "timeout": 15
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "\u2b50 The affixed `+` (create work order) is ON SCREEN at phone width",
                "noScreenshot": false,
                "params": {
                    "code": "const inView = el => { if (!el) return false; const r = el.getBoundingClientRect();\n  return r.width > 0 && r.height > 0 && r.left >= 0 && r.right <= window.innerWidth + 1\n    && r.top >= 0 && r.bottom <= window.innerHeight + 1; };\nconst b = document.querySelector('[class*=\"mantine-Affix-root\"] button');\nreturn inView(b);"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": true,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "\u2b50 The work list's search control is ON SCREEN at phone width",
                "noScreenshot": false,
                "params": {
                    "code": "const inView = el => { if (!el) return false; const r = el.getBoundingClientRect();\n  return r.width > 0 && r.height > 0 && r.left >= 0 && r.right <= window.innerWidth + 1\n    && r.top >= 0 && r.bottom <= window.innerHeight + 1; };\nreturn inView(document.querySelector('input[placeholder=\"Find Workstage(s)\"]'));"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": true,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": false,
                "name": "BY DESIGN: the header crew shortcut `.mobile-crew` exists but is hidden under 450px \u2014 the burger's `Switch Crews` is the phone path (optional)",
                "noScreenshot": false,
                "params": {
                    "code": "const c = document.querySelector('.mobile-crew');\nreturn !!c && getComputedStyle(c).display === 'none';"
                },
                "type": "assertFromJavascript",
                "timeout": 15
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The header itself rendered at phone width (the burger is on screen)",
                "noScreenshot": false,
                "params": {
                    "code": "const inView = el => { if (!el) return false; const r = el.getBoundingClientRect();\n  return r.width > 0 && r.height > 0 && r.left >= 0 && r.right <= window.innerWidth + 1\n    && r.top >= 0 && r.bottom <= window.innerHeight + 1; };\nreturn inView(document.querySelector('button[aria-label=\"Toggle navigation\"]'));"
                },
                "type": "assertFromJavascript",
                "timeout": 15
            }
        ]
    }
}