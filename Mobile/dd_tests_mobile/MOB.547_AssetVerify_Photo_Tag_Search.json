                "params": {
                    "code": "const opts = [...document.querySelectorAll('[role=\"option\"]')]\n  .map(o => (o.textContent || '').trim());\nconst create = opts.filter(t => t.indexOf('+ Create Tag') === 0);\nconst tags = opts.filter(t => t.indexOf('+ Create Tag') !== 0);\nreturn tags.length === 0 && create.some(t => t.indexOf(\"'ZZZZ-NO-SUCH-TAG'\") !== -1);"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
