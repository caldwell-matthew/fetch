{
    "test_name": "MOB.912_Offline_Connection_Screens",
    "details": {
        "name": "MOB.912_Offline_Connection_Screens",
        "type": "browser",
        "status": "paused",
        "message": "`MOB.912` **The screens that read `navigator.onLine` itself \u2014 online, then offline, same session.**\n- `MOB.910`'s `offline` event cannot reach them; `MOB.980` proved a step can define the\n  property. No `offline` event here, so navigation stays usable.\n- **Asset Lookup**: search input online \u2192 `history.back()` \u2192 override \u2192 the tile again \u2192\n  **ConnectionRequired** (OFFLINE_FEATURE_MESSAGE), no search input.\n- **Material tab**: CHARGES / ESTIMATES online \u2192 Notes \u2192 override \u2192 Material again (the panel\n  remounts) \u2192 **Internet Connection is required to make a material charge**, no CHARGES control.\n- \ud83d\uded1 **READ-ONLY**. Each leg restores with `always` steps: delete the getter, reload, and a\n  hard gate that the app reads online.",
        "tags": [
            "Mobile",
            "env:dev",
            "Offline",
            "Work Order",
            "Asset Lookup",
            "read-only"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "set_cookie": ""
        },
        "options": {
            "device_ids": [
                "chrome.tablet"
            ],
            "disable_cors": false,
            "disable_csp": false,
            "ignore_server_certificate_error": false,
            "min_failure_duration": 0,
            "min_location_failed": 1,
            "monitor_options": {},
            "no_screenshot": false,
            "retry": {
                "count": 1,
                "interval": 300.0
            },
            "rum_settings": {
                "is_enabled": false
            },
            "tick_every": 86400
        },
        "steps": [
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to the home screen",
                "noScreenshot": false,
                "params": {
                    "value": "https://dev.mentorapm.com/apm-mobile/"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let home render",
                "noScreenshot": false,
                "params": {
                    "value": 4
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "GATE: the home screen rendered",
                "noScreenshot": false,
                "params": {
                    "value": "Welcome,"
                },
                "type": "assertPageContains",
                "timeout": 60
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "BASELINE: online, and the Asset Lookup tile is on Home",
                "noScreenshot": false,
                "params": {
                    "code": "const tiles = () => [...document.querySelectorAll('img[alt^=\"icon for \"]')].map(i => i.getAttribute('alt') || '');\nreturn navigator.onLine === true && tiles().some(a => /Asset Lookup/i.test(a));"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Open Asset Lookup from its Home tile (online)",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//img[starts-with(@alt, \"icon for \") and contains(@alt, \"Asset Lookup\")]"
                                }
                            ]
                        }
                    }
                },
                "type": "click",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let Asset Lookup render",
                "noScreenshot": false,
                "params": {
                    "value": 4
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "ONLINE HALF: Asset Lookup renders its search \u2014 no ConnectionRequired",
                "noScreenshot": false,
                "params": {
                    "code": "return /\\/asset-lookup/.test(location.pathname) && !!document.querySelector('input[name=\"asset-search\"]')\n  && !(document.body.textContent || '').includes('This feature requires an internet connection.');"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Back to Home in-app (`history.back()` \u2014 no reload)",
                "noScreenshot": false,
                "params": {
                    "code": "history.back();\nreturn true;"
                },
                "type": "assertFromJavascript",
                "timeout": 15
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let Home render",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Home again, still the same page session (tile present)",
                "noScreenshot": false,
                "params": {
                    "code": "const tiles = () => [...document.querySelectorAll('img[alt^=\"icon for \"]')].map(i => i.getAttribute('alt') || '');\nreturn !/\\/asset-lookup/.test(location.pathname) && tiles().some(a => /Asset Lookup/i.test(a));"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "OVERRIDE: define an own `onLine` getter (false) on navigator \u2014 no `offline` event, so `useNetwork()` stays online",
                "noScreenshot": false,
                "params": {
                    "code": "Object.defineProperty(navigator, 'onLine', { configurable: true, get: function () { return false; } });\nreturn navigator.onLine === false;"
                },
                "type": "assertFromJavascript",
                "timeout": 15
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Open Asset Lookup from its Home tile (property offline)",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//img[starts-with(@alt, \"icon for \") and contains(@alt, \"Asset Lookup\")]"
                                }
                            ]
                        }
                    }
                },
                "type": "click",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let Asset Lookup render",
                "noScreenshot": false,
                "params": {
                    "value": 4
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "\u2b50 OFFLINE HALF: ConnectionRequired \u2014 OFFLINE_FEATURE_MESSAGE, and no search input",
                "noScreenshot": false,
                "params": {
                    "code": "return /\\/asset-lookup/.test(location.pathname)\n  && (document.body.textContent || '').includes('This feature requires an internet connection.')\n  && !document.querySelector('input[name=\"asset-search\"]');"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "RESTORE: remove the getter",
                "noScreenshot": false,
                "params": {
                    "code": "try { delete navigator.onLine; } catch (e) {}\nreturn true;"
                },
                "type": "assertFromJavascript",
                "timeout": 15
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to the home screen (a reload discards any override)",
                "noScreenshot": false,
                "params": {
                    "value": "https://dev.mentorapm.com/apm-mobile/"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let it render",
                "noScreenshot": false,
                "params": {
