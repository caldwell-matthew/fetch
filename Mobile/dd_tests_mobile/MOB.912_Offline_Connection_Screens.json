            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "ONLINE HALF: the Material panel shows its CHARGES / ESTIMATES control \u2014 no offline message",
                "noScreenshot": false,
                "params": {
                    "code": "const tabEl = document.querySelector('[role=\"tab\"][aria-selected=\"true\"], [role=\"tab\"][data-active]');\nconst byId = tabEl && tabEl.getAttribute('aria-controls')\n  ? document.getElementById(tabEl.getAttribute('aria-controls')) : null;\nconst p = byId || [...document.querySelectorAll('[role=\"tabpanel\"]')]\n  .find(x => x.style.display !== 'none');\nif (!p) return false;\nconst t = (p.textContent || '');\nconst segs = [...p.querySelectorAll('label, button')].map(e => (e.textContent || '').trim());\nreturn segs.includes('CHARGES') && segs.includes('ESTIMATES') && !t.includes('Internet Connection is required to make a material charge');"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
