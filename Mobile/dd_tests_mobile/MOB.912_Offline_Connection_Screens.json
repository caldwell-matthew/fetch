            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the Material panel render",
                "noScreenshot": false,
                "params": {
                    "value": 2
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "\u2b50 OFFLINE HALF: the panel reads `Internet Connection is required to make a material charge` \u2014 and the CHARGES control is gone",
                "noScreenshot": false,
                "params": {
                    "code": "const tabEl = document.querySelector('[role=\"tab\"][aria-selected=\"true\"], [role=\"tab\"][data-active]');\nconst byId = tabEl && tabEl.getAttribute('aria-controls')\n  ? document.getElementById(tabEl.getAttribute('aria-controls')) : null;\nconst p = byId || [...document.querySelectorAll('[role=\"tabpanel\"]')]\n  .find(x => x.style.display !== 'none');\nif (!p) return false;\nconst t = (p.textContent || '');\nconst segs = [...p.querySelectorAll('label, button')].map(e => (e.textContent || '').trim());\nreturn t.includes('Internet Connection is required to make a material charge') && !segs.includes('CHARGES');"
                },
