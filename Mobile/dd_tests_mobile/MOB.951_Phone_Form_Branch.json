{
    "test_name": "MOB.951_Phone_Form_Branch",
    "details": {
        "name": "MOB.951_Phone_Form_Branch",
        "type": "browser",
        "status": "paused",
        "message": "`MOB.951` **PHONE WIDTH \u2014 a work form renders its MOBILE branch.**\n- `FormDetails.tsx` picks the desktop form at `screen.availWidth >= 750` (MOB.355, on tablet)\n  and `#senor-work-form` below it \u2014 where `MobileSignatureField` lives. No tablet run can\n  reach it (trap 1).\n- Its image field renders the mobile `Upload Photo` button \u2014 asserted exactly when the server says the\n  opened form has an image field (never clicked: it opens a file dialog).\n- `chrome.mobile_small` ONLY; runs inside `MOB.984_Phone_Suite`. \ud83d\uded1 READ-ONLY.",
        "tags": [
            "Mobile",
            "env:dev",
            "Phone",
            "Work Order",
            "Forms",
            "read-only",
            "module:phone"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "set_cookie": ""
        },
        "options": {
            "device_ids": [
                "chrome.mobile_small"
            ],
            "disable_cors": false,
            "disable_csp": false,
            "ignore_server_certificate_error": false,
            "min_failure_duration": 0,
            "min_location_failed": 1,
            "monitor_options": {},
            "no_screenshot": false,
            "retry": {
                "count": 1,
                "interval": 300.0
            },
            "rum_settings": {
                "is_enabled": false
            },
            "tick_every": 86400
        },
        "steps": [
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to /work \u2014 warm the work lookup cache",
                "noScreenshot": false,
                "params": {
                    "value": "https://dev.mentorapm.com/apm-mobile/work"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the work list begin rendering",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The \"Work Orders\" page mounted",
                "noScreenshot": false,
                "params": {
                    "value": "Work Orders"
                },
                "type": "assertPageContains",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the lookup prefetch run",
                "noScreenshot": false,
                "params": {
                    "value": 30
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to the fixture work order",
                "noScreenshot": false,
                "params": {
                    "value": "https://dev.mentorapm.com/apm-mobile/work/EYRpYJ9QYdQ1JFF10JtB0Q"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the detail view begin rendering",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "GATE: the detail data arrived (tab strip)",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work/EYRpYJ9QYdQ1JFF10JtB0Q",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "(//*[@role=\"tab\"])[1]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementPresent",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "DEVICE: this session is PHONE width \u2014 `screen.availWidth` < 750 (the form's threshold)",
                "noScreenshot": false,
                "params": {
                    "code": "const w = window.screen.availWidth;\nreturn w > 0 && w < 750;"
                },
                "type": "assertFromJavascript",
                "timeout": 15
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Open the Forms tab",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work/EYRpYJ9QYdQ1JFF10JtB0Q",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[@role=\"tab\"][contains(normalize-space(.), \"Form\")]"
                                }
                            ]
                        }
                    }
                },
                "type": "click",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "GATE: the Forms tab is SELECTED \u2014 re-clicked every 3s until it is (a click on the settling tab strip can miss)",
                "noScreenshot": false,
                "params": {
                    "code": "const tab = [...document.querySelectorAll('[role=\"tab\"]')].find(t => (t.textContent || '').trim() === 'Forms');\nif (!tab) return false;\nif (tab.getAttribute('aria-selected') === 'true') return true;\nconst at = Number(sessionStorage.getItem('__dd951_forms_click') || 0);\nif (Date.now() - at > 3000) { sessionStorage.setItem('__dd951_forms_click', String(Date.now())); tab.click(); }\nreturn false;"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Remove the gate's sessionStorage key",
                "noScreenshot": false,
                "params": {
                    "code": "sessionStorage.removeItem('__dd951_forms_click');\nreturn true;"
                },
                "type": "assertFromJavascript",
                "timeout": 15
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the forms list",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "FIXTURE GUARD: the work order has at least one form card",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work/EYRpYJ9QYdQ1JFF10JtB0Q",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "(//*[@role=\"tabpanel\"][not(contains(@style, \"display: none\"))]//*[contains(concat(\" \", normalize-space(@class), \" \"), \" mantine-Paper-root \")][.//*[contains(concat(\" \", normalize-space(@class), \" \"), \" mantine-Title-root \")]])[1]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementPresent",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Open the first form card",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work/EYRpYJ9QYdQ1JFF10JtB0Q",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "(//*[@role=\"tabpanel\"][not(contains(@style, \"display: none\"))]//*[contains(concat(\" \", normalize-space(@class), \" \"), \" mantine-Paper-root \")][.//*[contains(concat(\" \", normalize-space(@class), \" \"), \" mantine-Title-root \")]])[1]"
                                }
                            ]
                        }
                    }
                },
                "type": "click",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the form page render",
                "noScreenshot": false,
                "params": {
                    "value": 4
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "ROUTE: we are on /work/<id>/form/<id>",
                "noScreenshot": false,
                "params": {
                    "code": "return /\\/work\\/[^/]+\\/form\\/[^/]+$/.test(location.pathname);"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "\u2b50 THE MOBILE FORM BRANCH: `#senor-work-form` rendered, and the desktop `#apm-dv-tabpanel` did NOT (`FormDetails.tsx`, `availWidth < 750`)",
                "noScreenshot": false,
                "params": {
                    "code": "return !!document.getElementById('senor-work-form') && !document.getElementById('apm-dv-tabpanel');"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "\u2b50 IMAGE FIELD (server): the form has an image field exactly when an `Upload Photo` button renders (`Forms/ImageInput.tsx:145`)",
                "noScreenshot": false,
                "params": {
                    "code": "const K = \"__dd951_server\", F = K + ':inflight', T = K + ':at';\nconst raw = sessionStorage.getItem(K);\nif (raw) {\n  let ok = false;\n  try { const data = (JSON.parse(raw) || {}).data; ok = !!data && !!((() => {\n  const formId = (location.pathname.match(/\\/form\\/([^/?#]+)/) || [])[1];\n  const form = ((data.workStage && data.workStage.forms) || []).find(f => f && f.id === formId);\n  if (!form || !document.getElementById('senor-work-form')) return false;\n  const hasImage = (form.fields || []).some(x => x && x.__typename === 'WorkStageFormDetail'\n    && x.attributeTypeId && x.attributeTypeId.type === 'image');\n  const button = [...document.querySelectorAll('button')]\n    .some(b => (b.textContent || '').replace(/\\s+/g, ' ').trim() === 'Upload Photo');\n  return hasImage === button;\n})()); } catch (e) { ok = false; }\n  if (ok) return true;\n  sessionStorage.removeItem(K);\n}\nif (!sessionStorage.getItem(F) && Date.now() - Number(sessionStorage.getItem(T) || 0) > 2000) {\n  sessionStorage.setItem(F, '1');\n  sessionStorage.setItem(T, String(Date.now()));\n  window.fetch('/graphql', { method: 'POST', credentials: 'same-origin',\n      headers: { 'content-type': 'application/json', 'apollo-require-preflight': '*' },\n      body: JSON.stringify({ query: \"query($id: ID!) { workStage(id: $id) { forms { id fields { __typename ... on WorkStageFormDetail { id attributeTypeId { type } } } } } }\", variables: {\"id\": \"EYRpYJ9QYdQ1JFF10JtB0Q\"} }) })\n    .then(r => r.json())\n    .then(j => { sessionStorage.setItem(K, JSON.stringify(j)); sessionStorage.removeItem(F); })\n    .catch(e => { sessionStorage.setItem(K, JSON.stringify({ errors: [String(e)] })); sessionStorage.removeItem(F); });\n}\nreturn false;"
                },
                "type": "assertFromJavascript",
                "timeout": 45
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Remove the server read's sessionStorage keys",
                "noScreenshot": false,
                "params": {
                    "code": "['__dd951_server', '__dd951_server:inflight', '__dd951_server:at'].forEach(k => sessionStorage.removeItem(k));\nreturn true;"
                },
                "type": "assertFromJavascript",
                "timeout": 15
            }
        ]
    }
}