            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "ROUTE: we are on /work/<id>/form/<id>",
                "noScreenshot": false,
                "params": {
                    "code": "return /\\/work\\/[^/]+\\/form\\/[^/]+$/.test(location.pathname);"
                },
                "type": "assertFromJavascript",
                "timeout": 60
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "\u2b50 The DESKTOP GRID mounted (`#apm-dv-tabpanel`) \u2014 this 768-wide tablet takes the wide branch (`screen.availWidth >= 750`), which is where the new signature cell lives",
                "noScreenshot": false,
                "params": {
                    "code": "return !!document.getElementById('apm-dv-tabpanel') && window.screen.availWidth >= 750;"
                },
                "type": "assertFromJavascript",
                "timeout": 60
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "PREMISE (server): the Inspection form holds ONE signature field, `Add a signature label`, UNSIGNED",
                "noScreenshot": false,
                "params": {
                    "code": "const K = \"__dd135_sig\", F = K + ':inflight', T = K + ':at';\nconst raw = sessionStorage.getItem(K);\nif (raw) {\n  let ok = false;\n  try { const data = (JSON.parse(raw) || {}).data; ok = !!data && !!((w => { const f = (w.forms || []).filter(f => (f.name || '').indexOf('Inspection') !== -1);\n  if (f.length !== 1) return false;\n  const s = f[0].widgets.filter(x => x.__typename === 'WorkflowFormSignature');\n  return s.length === 1 && s[0].label === 'Add a signature label' && !s[0].signature; })(data.workStage)); } catch (e) { ok = false; }\n  if (ok) return true;\n  sessionStorage.removeItem(K);\n}\nif (!sessionStorage.getItem(F) && Date.now() - Number(sessionStorage.getItem(T) || 0) > 2000) {\n  sessionStorage.setItem(F, '1');\n  sessionStorage.setItem(T, String(Date.now()));\n  window.fetch('/graphql', { method: 'POST', credentials: 'same-origin',\n      headers: { 'content-type': 'application/json', 'apollo-require-preflight': '*' },\n      body: JSON.stringify({ query: \"query($id: ID!) { workStage(id: $id) { forms { name widgets { __typename ... on WorkflowFormSignature { id label signature } } } } }\", variables: {\"id\": \"EYRpYJ9QYdQ1JFF10JtB0Q\"} }) })\n    .then(r => r.json())\n    .then(j => { sessionStorage.setItem(K, JSON.stringify(j)); sessionStorage.removeItem(F); })\n    .catch(e => { sessionStorage.setItem(K, JSON.stringify({ errors: [String(e)] })); sessionStorage.removeItem(F); });\n}\nreturn false;"
                },
                "type": "assertFromJavascript",
                "timeout": 45
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Remove the server read's sessionStorage keys",
                "noScreenshot": false,
                "params": {
                    "code": "['__dd135_sig', '__dd135_sig:inflight', '__dd135_sig:at'].forEach(k => sessionStorage.removeItem(k));\nreturn true;"
                },
                "type": "assertFromJavascript",
                "timeout": 15
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "\u2b50 The grid draws it with the MOBILE control: exactly one `.mobile-signature-cell`, labelled `Add a signature label`, its button reading `Add Signature`, no signature image yet",
                "noScreenshot": false,
                "params": {
                    "code": "const cells = [...document.querySelectorAll('#apm-dv-tabpanel .mobile-signature-cell')];\nconst cell = cells.length === 1 ? cells[0] : null;\nconst btn = cell && [...cell.querySelectorAll('button')].find(b => b.getAttribute('title') === 'Add Signature');\nreturn !!btn && (btn.textContent || '').trim() === 'Add Signature'\n  && (cell.textContent || '').includes('Add a signature label')\n  && !cell.querySelector('[data-testid=\"signature-image\"]');"
                },
                "type": "assertFromJavascript",
                "timeout": 45
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Open the pad (`Add Signature`)",
                "noScreenshot": false,
                "params": {
                    "code": "const cells = [...document.querySelectorAll('#apm-dv-tabpanel .mobile-signature-cell')];\nconst cell = cells.length === 1 ? cells[0] : null;\nconst btn = cell && [...cell.querySelectorAll('button')].find(b => b.getAttribute('title') === 'Add Signature');\nif (!btn) return false;\nbtn.click();\nreturn true;"
                },
                "type": "assertFromJavascript",
                "timeout": 20
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "\u2b50 The pad opened in a modal \u2014 a canvas and its `Clear` control (NOT clicked: Clear would queue a null signature that the close then saves)",
                "noScreenshot": false,
                "params": {
                    "code": "const pad = [...document.querySelectorAll('.mantine-Modal-content')]\n  .find(m => m.querySelector('canvas') && m.querySelector('[title=\"Clear\"]'));\nreturn !!pad;"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Close the pad WITHOUT drawing \u2014 its modal's close button",
                "noScreenshot": false,
                "params": {
                    "code": "const pad = [...document.querySelectorAll('.mantine-Modal-content')]\n  .find(m => m.querySelector('canvas') && m.querySelector('[title=\"Clear\"]'));\nconst c = pad && pad.querySelector('.mantine-Modal-close');\nif (!c) return false;\nc.click();\nreturn true;"
                },
                "type": "assertFromJavascript",
                "timeout": 20
            },
            {
                "allowFailure": false,
