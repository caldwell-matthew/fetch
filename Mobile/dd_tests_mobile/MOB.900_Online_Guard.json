{
    "test_name": "MOB.900_Online_Guard",
    "details": {
        "name": "MOB.900_Online_Guard",
        "type": "browser",
        "status": "paused",
        "message": "`MOB.900` Regression guard: the offline notice must not appear during a normal online run.\n- Asserts OFFLINE_FEATURE_MESSAGE (mobile/constants.ts) is absent on the home screen.\n- NOTE: Synthetics cannot take the browser offline, so this only catches the\n  false-positive direction (offline UI showing while actually online).",
        "tags": [
            "Mobile",
            "env:dev",
            "Offline"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "set_cookie": ""
        },
        "options": {
            "device_ids": [
                "chrome.tablet"
            ],
            "disable_cors": false,
            "disable_csp": false,
            "ignore_server_certificate_error": false,
            "min_failure_duration": 0,
            "min_location_failed": 1,
            "monitor_options": {},
            "no_screenshot": false,
            "retry": {
                "count": 1,
                "interval": 300.0
            },
            "rum_settings": {
                "is_enabled": false
            },
            "tick_every": 86400
        },
        "steps": [
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to mobile home",
                "noScreenshot": false,
                "params": {
                    "value": "{{ MOBDEV }}"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Guard: offline message must not be shown",
                "noScreenshot": false,
                "params": {
                    "value": "This feature requires an internet connection."
                },
                "type": "assertPageLacks"
            }
        ]
    }
}