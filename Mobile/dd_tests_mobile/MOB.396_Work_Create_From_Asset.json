                "params": {
                    "code": "\nconst ids = ['filterWorkflowByAsset', 'filterWorkflowByPMField'];\nlet seen = 0;\nfor (const id of ids) {\n  const el = document.getElementById(id);\n  const lab = document.querySelector('label[for=\"' + id + '\"]');\n  if (!el || !lab) continue;\n  seen += 1;\n  if (el.checked) lab.click();\n}\nreturn seen === ids.length;\n"
