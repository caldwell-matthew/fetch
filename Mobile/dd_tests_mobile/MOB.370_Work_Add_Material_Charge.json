{
    "test_name": "MOB.370_Work_Add_Material_Charge",
    "details": {
        "name": "MOB.370_Work_Add_Material_Charge",
        "type": "browser",
        "status": "paused",
        "message": "`MOB.370` Add a material charge to the fixture work order.\n- Fields cascade: storeroomLocationId -> materialItemId -> quantity. materialItemId\n  is disabled until a storeroom location is selected and is reset when it changes.\n- Visits /work first to warm the cache-only lookups (see module docstring).\n- MUTATES: adds a permanent material charge to EYRpYJ9QYdQ1JFF10JtB0Q on every run.",
        "tags": [
            "Mobile",
            "env:dev",
            "Work Order",
            "ELMO",
            "CRUD"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "set_cookie": ""
        },
        "options": {
            "device_ids": [
                "chrome.tablet"
            ],
            "disable_cors": false,
            "disable_csp": false,
            "ignore_server_certificate_error": false,
            "min_failure_duration": 0,
            "min_location_failed": 1,
            "monitor_options": {},
