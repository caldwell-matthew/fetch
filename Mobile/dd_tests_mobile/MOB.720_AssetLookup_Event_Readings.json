                "isCritical": true,
                "name": "EXACTLY ONE of: a 'recorded recently' progress row, or the empty state",
                "noScreenshot": false,
                "params": {
                    "code": "const f = document.querySelector('form[id^=\"asset-lookup-readings-\"]');\nif (!f) return false;\nconst panel = f.closest('[role=tabpanel]') || f.parentElement;\nconst txt = (panel.textContent || '');\nconst hasProgress = /recorded recently \\(in 24h\\)/.test(txt);\nconst hasEmpty = /No readings recorded for this asset\\./.test(txt);\nreturn hasProgress !== hasEmpty;"
