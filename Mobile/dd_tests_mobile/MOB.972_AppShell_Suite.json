{
    "test_name": "MOB.972_AppShell_Suite",
    "details": {
        "name": "MOB.972_AppShell_Suite",
        "type": "browser",
        "status": "paused",
        "message": "`MOB.972` Every route's shell: Home, the online and offline guards, Dev Logs, the Transaction Log, the hamburger menu, the back arrow, header status icons.\n- Writes: MOB.131 verifies and un-verifies an asset on the AV fixture job; MOB.131 before MOB.132, whose search reads those entries.\n- Logs in once, then chains its subtests in the same browser session, in this order.\n- Children are listed in `suite_plan.py`, the only place suite membership is kept.",
        "tags": [
            "Mobile",
            "env:dev",
            "Suite",
            "class:writes",
            "module:app-shell"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                },
                {
                    "id": "87b53e00-1675-4aa6-82c3-6e328e007d4b",
                    "name": "DATA_DOG_EMAIL",
                    "type": "global"
                },
                {
                    "id": "9c503d08-e175-464a-aa8e-dc9c0087ce30",
                    "name": "DATA_DOG_PASSWORD",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                },
                {
                    "id": "87b53e00-1675-4aa6-82c3-6e328e007d4b",
                    "name": "DATA_DOG_EMAIL",
                    "type": "global"
                },
                {
                    "id": "9c503d08-e175-464a-aa8e-dc9c0087ce30",
                    "name": "DATA_DOG_PASSWORD",
                    "type": "global"
                }
            ],
            "set_cookie": ""
        },
        "options": {
            "device_ids": [
                "chrome.tablet"
            ],
            "disable_cors": false,
            "disable_csp": false,
            "ignore_server_certificate_error": false,
            "min_failure_duration": 0,
            "min_location_failed": 1,
            "monitor_options": {},
            "no_screenshot": false,
            "retry": {
                "count": 1,
                "interval": 300.0
            },
            "rum_settings": {
                "is_enabled": false
            },
            "tick_every": 86400
        },
        "steps": [
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to mobile app",
                "noScreenshot": false,
                "params": {
                    "value": "{{ MOBDEV }}"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the SSO login form to hydrate",
                "noScreenshot": false,
                "params": {
                    "value": 5
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Type email",
                "noScreenshot": false,
                "params": {
                    "value": "{{ DATA_DOG_EMAIL }}",
                    "element": {
                        "url": "https://dev.mentorapm.com/login",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//input[@name=\"email\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "typeText"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Click \"Next\"",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/login",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//button[@type=\"submit\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "click"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
