                                {
                                    "type": "xpath",
                                    "value": "//li[contains(normalize-space(.), \"Ready:\")]"
                                }
                            ]
                        }
                    }
                },
                "type": "click"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the list to restore",
                "noScreenshot": false,
                "params": {
                    "value": 2
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The fixture job is back",
                "noScreenshot": false,
                "params": {
                    "value": "DATADOG MOBILE JOB"
                },
                "type": "assertPageContains"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Filter by \"In Progress\"",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-verify",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//li[contains(normalize-space(.), \"In Progress:\")]"
                                }
                            ]
                        }
                    }
                },
                "type": "click"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the list to re-filter",
                "noScreenshot": false,
                "params": {
                    "value": 2
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "PROOF: the In Progress filter keeps the fixture job",
