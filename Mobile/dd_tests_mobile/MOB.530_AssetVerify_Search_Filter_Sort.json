                "exitIfSucceed": false,
                "isCritical": true,
                "name": "FIXTURE GUARD: \"DATADOG MOBILE JOB\" is in this crew's list",
                "noScreenshot": false,
                "params": {
                    "value": "DATADOG MOBILE JOB"
                },
                "type": "assertPageContains"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Baseline: the fixture job is listed",
                "noScreenshot": false,
                "params": {
                    "value": "DATADOG MOBILE JOB"
                },
                "type": "assertPageContains"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Filter by \"Ready\"",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-verify",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//li[contains(normalize-space(.), \"Ready:\")]"
                                }
                            ]
                        }
                    }
                },
                "type": "click"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the list to re-filter",
                "noScreenshot": false,
                "params": {
                    "value": 2
