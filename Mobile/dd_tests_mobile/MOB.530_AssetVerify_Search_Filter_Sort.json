{
    "test_name": "MOB.530_AssetVerify_Search_Filter_Sort",
    "details": {
        "name": "MOB.530_AssetVerify_Search_Filter_Sort",
        "type": "browser",
        "status": "paused",
        "message": "`MOB.530` Search, status filter and sort on the mobile job list.\n- READ-ONLY. Nothing here mutates, so the suite stays self-restoring.\n- This is the **SB** block built where it can be proven: the fixture job is a known\n  record, so a non-matching search asserts it DISAPPEARS. MOB.340 can only prove the\n  work-list search box accepts text - no work order there is known-stable.\n- The status filter is proven the same way: the fixture is `IN_PROGRESS`, so selecting\n  `Ready` must hide it. Every filter click is paired with a second click to untoggle.\n- Sort is opened and dismissed but NOT applied: its labels are schema-derived, proving\n  an order needs two known records, and a selection would persist in sessionStorage\n  into later subtests.",
        "tags": [
            "Mobile",
            "env:dev",
            "Asset Verification",
            "read-only",
            "SB"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "set_cookie": ""
        },
        "options": {
            "device_ids": [
                "chrome.tablet"
            ],
            "disable_cors": false,
            "disable_csp": false,
            "ignore_server_certificate_error": false,
            "min_failure_duration": 0,
            "min_location_failed": 1,
            "monitor_options": {},
            "no_screenshot": false,
            "retry": {
                "count": 1,
                "interval": 300.0
            },
            "rum_settings": {
                "is_enabled": false
            },
            "tick_every": 86400
        },
        "steps": [
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to the mobile job list",
                "noScreenshot": false,
                "params": {
                    "value": "https://dev.mentorapm.com/apm-mobile/asset-verify"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the page to mount",
                "noScreenshot": false,
                "params": {
                    "value": 10
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Test the \"Mobile Jobs\" page mounted",
                "noScreenshot": false,
                "params": {
                    "check": "contains",
                    "value": "Mobile Jobs",
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-verify",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[@id=\"page-title\"]//h4[contains(normalize-space(.), \"Mobile Jobs\")]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementContent"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the lookup prefetch and batched detail downloads",
                "noScreenshot": false,
                "params": {
                    "value": 25
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Test the job list rendered",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-verify",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//input[@placeholder=\"Find Mobile Job(s)\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementPresent"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Test the lookup prefetch finished (feeds schemaQuery)",
                "noScreenshot": false,
                "params": {
                    "value": "Fetching data for lookups"
                },
                "type": "assertPageLacks"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Test the batched job-detail downloads finished",
                "noScreenshot": false,
                "params": {
                    "value": "Fetching mobile job details"
