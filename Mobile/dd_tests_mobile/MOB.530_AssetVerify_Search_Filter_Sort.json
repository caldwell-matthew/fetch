            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Search for the fixture job",
                "noScreenshot": false,
                "params": {
                    "value": "DATADOG MOBILE JOB",
                    "element": {
