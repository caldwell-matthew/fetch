                "isCritical": true,
                "name": "The cycling arrows next to Tank 0000 are rendered",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-verify/Z0EVwQcdJZhMURcBFkp0E0",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//button[.//*[@data-icon=\"circle-arrow-right\" or contains(concat(\" \", normalize-space(@class), \" \"), \" fa-circle-arrow-right \")]][parent::*[contains(., \"Tank 0000\")]]"
                                }
