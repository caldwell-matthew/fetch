                "isCritical": true,
                "name": "BASELINE: the cycler shows \"Tank 0000\"",
                "noScreenshot": false,
                "params": {
                    "code": "const groups = [...document.querySelectorAll('button')]\n  .filter(b => b.querySelector('[data-icon=\"circle-arrow-right\"]'))\n  .map(b => b.parentElement).filter(Boolean);\nif (!groups.length) return false;\nreturn groups.some(g => (g.textContent || '').indexOf('Tank 0000') !== -1);"
                },
                "type": "assertFromJavascript",
                "timeout": 30
