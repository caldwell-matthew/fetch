{
    "test_name": "MOB.220_Crew_Scoping",
    "details": {
        "name": "MOB.220_Crew_Scoping",
        "type": "browser",
        "status": "paused",
        "message": "`MOB.220` Prove switching crew changes the visible mobile-job set.\n- SELF-RESTORING: switches crew and back to `Admin`.\n- Uses `Admin 0100` \u2014 read is ON, so the job list still loads. That isolates\n  CREW SCOPING from permissions: if the fixture job disappears here it is because the\n  crew changed, not because the role cannot read. Using `Admin 0000` would\n  confound the two.\n- The PROOF is the negative: `DATADOG MOBILE JOB` is listed under `Admin` and must NOT be\n  listed under another crew, because `mobileJobsForCrew` scopes by the session crew.\n- A crew is a role in MentorTwo, so switching role IS switching crew.",
        "tags": [
            "Mobile",
            "env:dev",
            "Session",
            "permissions",
            "CRUD"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "set_cookie": ""
        },
        "options": {
            "device_ids": [
                "chrome.tablet"
            ],
            "disable_cors": false,
            "disable_csp": false,
            "ignore_server_certificate_error": false,
            "min_failure_duration": 0,
            "min_location_failed": 1,
            "monitor_options": {},
            "no_screenshot": false,
            "retry": {
                "count": 1,
                "interval": 300.0
            },
            "rum_settings": {
                "is_enabled": false
            },
            "tick_every": 86400
        },
        "steps": [
