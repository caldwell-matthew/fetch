{
    "test_name": "MOB.730_AssetLookup_Proximity",
    "details": {
        "name": "MOB.730_AssetLookup_Proximity",
        "type": "browser",
        "status": "paused",
        "message": "`MOB.730` The **\"Near Me\" radius menu** on Asset Lookup \u2014 a feature that landed\n2026-08-21 and was found by diffing `client/mobile`, not by a walk.\n- \ud83d\uded1 **No radius is ever clicked.** Each one calls `getCurrentPosition`, which a\n  Synthetics runner cannot satisfy \u2014 10s of timeout and a `toast.error`, proving nothing.\n  **The menu is reachable; the location is Appendix C.**\n- **The negative is the point**: `Update my location` and `Clear` sit behind\n  `{!!value && ...}`, so they must be ABSENT with no radius set \u2014 asserted alongside the\n  five radii being PRESENT, so it cannot pass on a menu that never opened (trap 5).\n- The button's label is state, not decoration \u2014 `Near Me` vs `Within {n} mi` \u2014 so\n  asserting it doubles as the baseline guard.\n- \ud83d\uded1 **UNIT-AGNOSTIC BY REQUIREMENT, not by taste.** The radius options are\n  `${radius} ${distanceUnit}` and BOTH halves come from the **browser locale**\n  (`utils/distance`): `5/10/25/50/100 mi` imperial, `10/25/50/100/200 km` metric.\n  This test pinned `N miles` until 2026-09-08 and had been broken since the 09-02\n  localization commit. \u26a0\ufe0f **The failure was two-sided**: the positive check went red,\n  and its paired absence check started passing **vacuously** \u2014 a green step that could\n  never fail again. The set assertion now also rejects a MIX of units.\n- \u26a0\ufe0f **Persists and auto-locates**: a stored\n  `sessionStorage['asset_lookup_proximity_radius']` makes the page request geolocation on\n  MOUNT, for every later subtest in the shared session. This test asserts the key is\n  empty before and after, and must never be what sets it.",
        "tags": [
            "Mobile",
            "env:dev",
            "Asset Lookup",
            "read-only"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "set_cookie": ""
        },
        "options": {
            "device_ids": [
                "chrome.tablet"
            ],
            "disable_cors": false,
            "disable_csp": false,
            "ignore_server_certificate_error": false,
            "min_failure_duration": 0,
            "min_location_failed": 1,
            "monitor_options": {},
            "no_screenshot": false,
            "retry": {
                "count": 1,
                "interval": 300.0
            },
            "rum_settings": {
                "is_enabled": false
            },
            "tick_every": 86400
        },
        "steps": [
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to asset lookup",
                "noScreenshot": false,
                "params": {
                    "value": "https://dev.mentorapm.com/apm-mobile/asset-lookup"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the page mount",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The \"Asset Lookup\" page rendered",
                "noScreenshot": false,
                "params": {
                    "check": "contains",
                    "value": "Asset Lookup",
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-lookup",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[@id=\"page-title\"]//h4[contains(normalize-space(.), \"Asset Lookup\")]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementContent",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "BASELINE: no radius is stored in sessionStorage['asset_lookup_proximity_radius']",
                "noScreenshot": false,
                "params": {
                    "code": "const v = sessionStorage.getItem('asset_lookup_proximity_radius');\nreturn v === null || v === 'null' || v === '';"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The \"Near Me\" button renders \u2014 the no-radius label",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-lookup",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//button[contains(normalize-space(.), \"Near Me\")]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementPresent",
                "timeout": 60
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "SETTLE GATE: the search input is interactive \u2014 the page finished its first render",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-lookup",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//input[@name=\"asset-search\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementPresent",
                "timeout": 60
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the first asset query settle before touching the menu",
                "noScreenshot": false,
                "params": {
                    "value": 4
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Open the \"Near Me\" menu",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-lookup",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "(//button[contains(normalize-space(.), \"Near Me\")])[1]"
                                }
                            ]
                        }
                    }
                },
                "type": "click",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The menu is headed \"Search radius\"",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-lookup",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[contains(concat(\" \", normalize-space(@class), \" \"), \" mantine-Menu-label \")][normalize-space(.)=\"Search radius\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementPresent",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "All five radii are offered, and they are exactly ONE locale's set \u2014 5/10/25/50/100 mi or 10/25/50/100/200 km, never a mix",
                "noScreenshot": false,
                "params": {
                    "code": "const items = [...document.querySelectorAll('.mantine-Menu-item')].map(e => (e.textContent || '').trim());\nconst got = items.filter(t => /^\\d+ (mi|km)$/.test(t));\nconst IMPERIAL = [\"5 mi\", \"10 mi\", \"25 mi\", \"50 mi\", \"100 mi\"];\nconst METRIC = [\"10 km\", \"25 km\", \"50 km\", \"100 km\", \"200 km\"];\nconst same = (a, b) => a.length === b.length && b.every(x => a.includes(x));\nreturn got.length === 5 && (same(got, IMPERIAL) || same(got, METRIC));"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "\"Update my location\" and \"Clear\" are ABSENT while no radius is set",
                "noScreenshot": false,
                "params": {
                    "code": "const items = [...document.querySelectorAll('.mantine-Menu-item')].map(e => (e.textContent || '').trim());\nreturn !items.includes('Update my location') && !items.includes('Clear');"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Close the menu WITHOUT choosing a radius (a click would call getCurrentPosition \u2014 Appendix C)",
                "noScreenshot": false,
                "params": {
                    "value": "Escape"
                },
                "type": "pressKey"
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the menu close",
                "noScreenshot": false,
                "params": {
                    "value": 1
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "GUARD: nothing was chosen \u2014 the menu is closed (MEANINGFUL ONLY because the same /^\\d+ (mi|km)$/ matched five items above \u2014 do not decouple them)",
                "noScreenshot": false,
                "params": {
                    "code": "const items = [...document.querySelectorAll('.mantine-Menu-item')].map(e => (e.textContent || '').trim());\nreturn items.filter(t => /^\\d+ (mi|km)$/.test(t)).length === 0;"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "CLEAN: sessionStorage['asset_lookup_proximity_radius'] is still empty",
                "noScreenshot": false,
                "params": {
                    "code": "const v = sessionStorage.getItem('asset_lookup_proximity_radius');\nreturn v === null || v === 'null' || v === '';"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "RESTORED: the button still reads \"Near Me\"",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-lookup",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//button[contains(normalize-space(.), \"Near Me\")]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementPresent",
                "timeout": 30
            }
        ]
    }
}