{
    "test_name": "MOB.979_DIAG_Map_Probe",
    "details": {
        "name": "MOB.979_DIAG_Map_Probe",
        "type": "browser",
        "status": "paused",
        "message": "**TEMPORARY DIAGNOSTIC \u2014 not coverage. Delete once T2.6 is settled.**\n- Answers, in ONE run, whether the Mobile Map is reachable by a Datadog browser test.\n- Every probe is `optional`, so the test passes and `report` shows which probes failed.\n- The decisive one is the **WebGL canvas**: if it never appears, the map mounts but never\n  paints, and T2.6's two items plus the map `Add Work` entry point become an honest\n  Appendix C entry instead of sitting open.\n- `MOB.120` already proves the *route* renders; this is about the map itself.",
        "tags": [
            "Mobile",
            "env:dev",
            "diagnostic",
            "read-only"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                },
                {
                    "id": "87b53e00-1675-4aa6-82c3-6e328e007d4b",
                    "name": "DATA_DOG_EMAIL",
                    "type": "global"
                },
                {
                    "id": "9c503d08-e175-464a-aa8e-dc9c0087ce30",
                    "name": "DATA_DOG_PASSWORD",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                },
                {
                    "id": "87b53e00-1675-4aa6-82c3-6e328e007d4b",
                    "name": "DATA_DOG_EMAIL",
                    "type": "global"
                },
                {
                    "id": "9c503d08-e175-464a-aa8e-dc9c0087ce30",
                    "name": "DATA_DOG_PASSWORD",
                    "type": "global"
                }
            ],
            "set_cookie": ""
        },
        "options": {
            "device_ids": [
                "chrome.tablet"
            ],
            "disable_cors": false,
            "disable_csp": false,
            "ignore_server_certificate_error": false,
            "min_failure_duration": 0,
            "min_location_failed": 1,
            "monitor_options": {},
            "no_screenshot": false,
            "retry": {
                "count": 1,
                "interval": 300.0
            },
            "rum_settings": {
