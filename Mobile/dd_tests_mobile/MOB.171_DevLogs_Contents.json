                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The \"Refresh\" button renders",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/logz",
