                "name": "EXACTLY ONE of: log entries, or the 'No logs found.' empty state",
                "noScreenshot": false,
                "params": {
                    "code": "const t = document.body.innerText || '';\nconst empty = /No logs found\\./.test(t);\nconst entries = [...document.querySelectorAll('.mantine-Paper-root')].filter(e => /(INFO|ERROR|DEBUG|WARN)/.test(e.textContent||'')).length > 0;\nreturn empty !== entries;"
