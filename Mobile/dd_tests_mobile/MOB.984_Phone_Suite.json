{
    "test_name": "MOB.984_Phone_Suite",
    "details": {
        "name": "MOB.984_Phone_Suite",
        "type": "browser",
        "status": "paused",
        "message": "`MOB.984` **The PHONE-WIDTH suite** \u2014 `chrome.mobile_small` only, READ-ONLY.\n- Logs in once, then chains its subtests in the same browser session.\n- Run it ON ITS OWN (trap 1: never alongside a mutating tablet suite).\n- subtestPublicId values stay PENDING-WIRE-UP until the children exist on Datadog;\n  run wire_suite.py after pushing them.",
        "tags": [
            "Mobile",
            "env:dev",
            "Phone",
            "suite",
            "read-only"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                },
                {
                    "id": "87b53e00-1675-4aa6-82c3-6e328e007d4b",
                    "name": "DATA_DOG_EMAIL",
                    "type": "global"
                },
                {
                    "id": "9c503d08-e175-464a-aa8e-dc9c0087ce30",
                    "name": "DATA_DOG_PASSWORD",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                },
                {
                    "id": "87b53e00-1675-4aa6-82c3-6e328e007d4b",
                    "name": "DATA_DOG_EMAIL",
                    "type": "global"
                },
                {
                    "id": "9c503d08-e175-464a-aa8e-dc9c0087ce30",
                    "name": "DATA_DOG_PASSWORD",
                    "type": "global"
                }
            ],
            "set_cookie": ""
        },
        "options": {
            "device_ids": [
                "chrome.mobile_small"
            ],
            "disable_cors": false,
            "disable_csp": false,
            "ignore_server_certificate_error": false,
            "min_failure_duration": 0,
            "min_location_failed": 1,
            "monitor_options": {},
            "no_screenshot": false,
            "retry": {
                "count": 1,
                "interval": 300.0
            },
            "rum_settings": {
                "is_enabled": false
            },
            "tick_every": 86400
        },
        "steps": [
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to mobile app",
                "noScreenshot": false,
                "params": {
                    "value": "{{ MOBDEV }}"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the SSO login form to hydrate",
                "noScreenshot": false,
                "params": {
                    "value": 5
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Type email",
                "noScreenshot": false,
                "params": {
                    "value": "{{ DATA_DOG_EMAIL }}",
                    "element": {
                        "url": "https://dev.mentorapm.com/login",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//input[@name=\"email\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "typeText"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Click \"Next\"",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/login",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//button[@type=\"submit\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "click"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Type password",
                "noScreenshot": false,
                "params": {
                    "value": "{{ DATA_DOG_PASSWORD }}",
                    "element": {
                        "url": "https://dev.mentorapm.com/login",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//input[@name=\"password\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "typeText"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Click \"Submit\"",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/login",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//button[@type=\"submit\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "click"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Choose the \"development\" environment",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/login/sso?src=mobile",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "(//button[contains(concat(\" \", normalize-space(@class), \" \"), \" enviroment-button \")][contains(concat(\" \", normalize-space(@class), \" \"), \" enviroment-btn--active \")][.//p[normalize-space(.)=\"development\"]])[1]"
                                }
                            ]
                        }
                    }
                },
                "type": "click"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the app shell to mount after the env redirect",
                "noScreenshot": false,
                "params": {
                    "value": 10
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "CRASH GUARD (boot): the ErrorBoundary has NOT replaced the app \u2014 no \"Something went wrong.\"",
                "noScreenshot": false,
                "params": {
                    "value": "Something went wrong."
                },
                "type": "assertPageLacks"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Test authenticated mobile shell rendered",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//button[@aria-label=\"Toggle navigation\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementPresent"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Open the menu to read the session role",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//button[@aria-label=\"Toggle navigation\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "click"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Guard: session role is exactly \"Admin\"",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//button[.//div[normalize-space(.)=\"Switch Crews\"]]//div[normalize-space(.)=\"Admin\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementPresent"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Close the menu",
                "noScreenshot": false,
                "params": {
                    "value": "Escape"
                },
                "type": "pressKey"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "MOB.951_Phone_Form_Branch",
                "noScreenshot": false,
                "params": {
                    "subtestPublicId": "q68-kn3-kdt",
                    "playingTabId": -1
                },
                "type": "playSubTest"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "MOB.952_Phone_Header_And_List",
