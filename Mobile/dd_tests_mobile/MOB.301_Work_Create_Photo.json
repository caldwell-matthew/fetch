{
    "test_name": "MOB.301_Work_Create_Photo",
    "details": {
        "name": "MOB.301_Work_Create_Photo",
        "type": "browser",
        "status": "paused",
        "message": "`MOB.301` **A photo reaches the new-work-order form's carousel \u2014 without submitting.**\n- Baseline: no carousel (`PhotoCarousel` has no empty state) and `Add Work Order Photo`\n  offered (gated on the role's `work.update`).\n- After an upload (MOB.600's bucketKey, copied): exactly one slide in\n  `#workorder-insert-form`, its image a **`blob:` URL** \u2014 held locally, not uploaded \u2014 and\n  the label unchanged (this call site's label is fixed; the collector's flips).\n- \ud83d\uded1 **READ-ONLY**: `addImages` is component state; files are enqueued only after the\n  create mutation returns a work id. This test never submits and closes the form with its X.",
        "tags": [
            "Mobile",
            "env:dev",
            "Work Order",
            "Photos",
            "read-only"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "set_cookie": ""
        },
        "options": {
            "device_ids": [
                "chrome.tablet"
            ],
            "disable_cors": false,
            "disable_csp": false,
            "ignore_server_certificate_error": false,
            "min_failure_duration": 0,
            "min_location_failed": 1,
            "monitor_options": {},
            "no_screenshot": false,
            "retry": {
                "count": 1,
                "interval": 300.0
            },
            "rum_settings": {
                "is_enabled": false
            },
            "tick_every": 86400
        },
        "steps": [
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to /work",
                "noScreenshot": false,
                "params": {
                    "value": "https://dev.mentorapm.com/apm-mobile/work"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the work list and lookups load",
                "noScreenshot": false,
                "params": {
                    "value": 10
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Test the \"Work Orders\" page rendered",
                "noScreenshot": false,
                "params": {
                    "check": "contains",
                    "value": "Work Orders",
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[@id=\"page-title\"]//h4[contains(normalize-space(.), \"Work Orders\")]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementContent",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Open the create-work-order form (affixed + button)",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//div[contains(concat(\" \", normalize-space(@class), \" \"), \" mantine-Affix-root \")]//button"
                                }
                            ]
                        }
                    }
                },
                "type": "click",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the form mount",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The create form rendered",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//form[@id=\"workorder-insert-form\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementPresent",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "BASELINE: no carousel yet, and `Add Work Order Photo` is offered (the role has `work.update`)",
                "noScreenshot": false,
                "params": {
                    "code": "const f = document.getElementById('workorder-insert-form');\nif (!f) return false;\nconst slides = f.querySelectorAll('[class*=\"mantine-Carousel-slide\"]');\nconst carousels = f.querySelectorAll('[class*=\"mantine-Carousel-root\"]');\nconst labels = [...document.querySelectorAll('button')].map(b => (b.textContent || '').trim());\nreturn carousels.length === 0 && slides.length === 0\n  && labels.includes('Add Work Order Photo');"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Open the photo picker (`Add Work Order Photo`)",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//button[normalize-space(.)=\"Add Work Order Photo\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "click",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The picker opened \u2014 \"Select Photo Source\"",
                "noScreenshot": false,
                "params": {
                    "value": "Select Photo Source"
                },
                "type": "assertPageContains",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Reveal the hidden gallery file input (useFileDialog appends it to <body>)",
                "noScreenshot": false,
                "params": {
                    "code": "const inputs = [...document.querySelectorAll('input[type=\"file\"]')];\nconst el = inputs.find(i => !i.capture);\nif (!el) return false;\nel.setAttribute('data-dd-upload', '1');\nObject.assign(el.style, {\n  display: 'block', opacity: '1', position: 'fixed',\n  top: '0', left: '0', width: '240px', height: '40px', zIndex: '99999'\n});\nreturn true;\n"
                },
                "type": "assertFromJavascript"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Upload a photo \u2014 MOB.600's bucketKey, copied (trap 12)",
                "noScreenshot": false,
                "params": {
                    "files": [
                        {
                            "name": "Screenshot 2024-12-11 at 3.23.46\u202fPM.png",
                            "size": 25762,
                            "bucketKey": "browser-upload-file-step/4ty-vhq-3aa/2026-08-11T01:17:31.314568_2a1bff34-f062-4bb4-a6bf-9c9c3551f896.json"
                        }
                    ],
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work",
                        "userLocator": {
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//input[@data-dd-upload=\"1\"]"
                                }
                            ],
                            "failTestOnCannotLocate": true
                        },
                        "multiLocator": {
                            "ab": "/*[local-name()=\"html\"][1]/*[local-name()=\"body\"][1]/*[local-name()=\"input\"][3]",
                            "at": "",
                            "cl": "/*[local-name()=\"html\"]/*[local-name()=\"body\"]/*[local-name()=\"input\"][3]",
                            "co": "",
                            "ro": "//*[local-name()=\"input\"][3]",
                            "clt": "/*[local-name()=\"html\"]/*[local-name()=\"body\"]/*[local-name()=\"input\"][3]"
                        },
                        "targetOuterHTML": "<input type=\"file\" accept=\"image/*\" multiple=\"\" style=\"display: block; opacity: 1; position: fixed; top: 0px; left: 0px; width: 240px; height: 40px; z-index: 99999;\" data-dd-upload=\"1\">"
                    },
                    "withClick": false
                },
                "type": "uploadFiles"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The picker closed itself once the file arrived (`onDialogChange` \u2014 MOB.621)",
                "noScreenshot": false,
                "params": {
                    "value": "Select Photo Source"
                },
                "type": "assertPageLacks",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the form take the photo and the carousel mount",
                "noScreenshot": false,
                "params": {
                    "value": 4
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "\u2b50 ONE photo in the form's carousel \u2014 `addImages` took it",
                "noScreenshot": false,
                "params": {
                    "code": "const f = document.getElementById('workorder-insert-form');\nif (!f) return false;\nconst slides = f.querySelectorAll('[class*=\"mantine-Carousel-slide\"]');\nconst carousels = f.querySelectorAll('[class*=\"mantine-Carousel-root\"]');\nconst labels = [...document.querySelectorAll('button')].map(b => (b.textContent || '').trim());\nreturn carousels.length >= 1 && slides.length === 1;"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "\u2b50 \u2026held LOCALLY: the slide's image is a `blob:` URL (`URL.createObjectURL`), not a server link \u2014 nothing is uploaded before submit",
                "noScreenshot": false,
                "params": {
                    "code": "const f = document.getElementById('workorder-insert-form');\nif (!f) return false;\nconst imgs = [...f.querySelectorAll('[class*=\"mantine-Carousel-slide\"] img')];\nreturn imgs.length >= 1 && imgs.every(i => (i.getAttribute('src') || '').indexOf('blob:') === 0);"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "\u2026and the button still reads `Add Work Order Photo` \u2014 this call site passes a fixed label; it does not flip like the collector's",
                "noScreenshot": false,
                "params": {
                    "code": "const f = document.getElementById('workorder-insert-form');\nif (!f) return false;\nconst slides = f.querySelectorAll('[class*=\"mantine-Carousel-slide\"]');\nconst carousels = f.querySelectorAll('[class*=\"mantine-Carousel-root\"]');\nconst labels = [...document.querySelectorAll('button')].map(b => (b.textContent || '').trim());\nreturn labels.includes('Add Work Order Photo')\n  && !labels.includes('Add More Photos');"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Close the form with its X \u2014 DISCARDING the photo, never submitting",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[contains(concat(\" \", normalize-space(@class), \" \"), \" mantine-Modal-content \")][.//form[@id=\"workorder-insert-form\"]]//button[contains(concat(\" \", normalize-space(@class), \" \"), \" mantine-Modal-close \")]"
                                }
                            ]
                        }
                    }
                },
                "type": "click",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the form close",
                "noScreenshot": false,
                "params": {
                    "value": 2
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "RESTORED: the form is unmounted, so the photo was discarded unsent",
                "noScreenshot": false,
                "params": {
                    "code": "return !document.getElementById('workorder-insert-form');"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            }
        ]
    }
}