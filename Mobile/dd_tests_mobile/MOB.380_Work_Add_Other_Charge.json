{
    "test_name": "MOB.380_Work_Add_Other_Charge",
    "details": {
        "name": "MOB.380_Work_Add_Other_Charge",
        "type": "browser",
        "status": "paused",
        "message": "`MOB.380` Add an \"other\" charge to the fixture work order.\n- OtherCharges supplies no customFormFields, so the form is whatever the\n  WorkStageOtherCharge schema defines. otherChargeId + quantity are INFERRED from\n  the rendered charge item, and userId comes from the schema (required AND\n  insertable). transactionAmount is required but insertable=false - server-derived,\n  so it is deliberately NOT filled.\n- Visits /work first to warm the cache-only lookups (see module docstring).\n- MUTATES: adds a permanent other charge to EYRpYJ9QYdQ1JFF10JtB0Q on every run.",
        "tags": [
            "Mobile",
            "env:dev",
            "Work Order",
            "ELMO",
            "CRUD"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "set_cookie": ""
        },
        "options": {
