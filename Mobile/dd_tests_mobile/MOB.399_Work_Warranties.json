                "noScreenshot": false,
                "params": {
                    "check": "contains",
                    "value": "Work Orders",
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
