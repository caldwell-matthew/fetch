{
    "test_name": "MOB.399_Work_Warranties",
    "details": {
        "name": "MOB.399_Work_Warranties",
        "type": "browser",
        "status": "paused",
        "message": "`MOB.399` The **Warranties** tab renders its real content.\n- READ-ONLY. `WarrentyList` displays only; there is no form.\n- The fixture carries a **real warranty** (added by the repo owner 2026-08-12), so this\n  asserts actual content: `Expiration Date` for a Time warranty or `Exp. Reading` for a\n  reading-based one. **The `No Warranties Found...` empty state is deliberately NOT\n  accepted** \u2014 allowing it would leave an escape hatch that passes on a tab rendering\n  nothing (trap 5).\n- **Also covers the red `Assets Related to the Work Order are under Warranty` banner**\n  (added 2026-08-20). It is driven by `hasActiveWarranties`, NOT by the tab, so the two\n  can legitimately disagree: the tab lists every warranty, the banner appears only while\n  one is still ACTIVE. The assertion is therefore a **consistency** check, not a\n  presence check \u2014 see the note in the generator.",
        "tags": [
            "Mobile",
            "env:dev",
            "Work Order",
            "read-only"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "set_cookie": ""
        },
        "options": {
            "device_ids": [
                "chrome.tablet"
            ],
            "disable_cors": false,
            "disable_csp": false,
            "ignore_server_certificate_error": false,
            "min_failure_duration": 0,
            "min_location_failed": 1,
            "monitor_options": {},
            "no_screenshot": false,
            "retry": {
                "count": 1,
                "interval": 300.0
            },
            "rum_settings": {
                "is_enabled": false
            },
            "tick_every": 86400
        },
        "steps": [
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to /work to warm the lookup cache",
                "noScreenshot": false,
                "params": {
                    "value": "https://dev.mentorapm.com/apm-mobile/work"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the work list and lookup prefetch",
                "noScreenshot": false,
                "params": {
                    "value": 20
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to the fixture work order",
                "noScreenshot": false,
                "params": {
                    "value": "https://dev.mentorapm.com/apm-mobile/work/EYRpYJ9QYdQ1JFF10JtB0Q"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the detail view begin rendering",
                "noScreenshot": false,
                "params": {
                    "value": 2
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Test work order detail rendered",
                "noScreenshot": false,
                "params": {
                    "value": "Status:"
                },
                "type": "assertPageContains",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Open the \"Warranties\" tab",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work/EYRpYJ9QYdQ1JFF10JtB0Q",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[@role=\"tab\"][normalize-space(.)=\"Warranties\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "click"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the panel",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The \"Warranties\" tab is active",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work/EYRpYJ9QYdQ1JFF10JtB0Q",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[@role=\"tab\"][normalize-space(.)=\"Warranties\"][@data-active]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementPresent"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "PROOF: the panel rendered warranty content or its empty state, not a blank tab",
                "noScreenshot": false,
                "params": {
                    "code": "\nconst t = (document.body.textContent || '');\nreturn ['Expiration Date', 'Remaining Days', 'Current Reading', 'Exp. Reading']\n  .some(k => t.indexOf(k) !== -1);\n"
                },
                "type": "assertFromJavascript"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "BANNER: its presence agrees with whether a warranty is still active",
                "noScreenshot": false,
                "params": {
                    "code": "\nconst BANNER = 'Assets Related to the Work Order are under Warranty';\nconst t = document.body.innerText || '';\nconst banner = t.indexOf(BANNER) !== -1;\nconst hasAnyWarranty = ['Expiration Date', 'Exp. Reading', 'Remaining Days']\n    .some(k => t.indexOf(k) !== -1);\nif (!hasAnyWarranty) return !banner;          // no warranties at all -> no banner\nconst days = [...t.matchAll(/Remaining Days:?\\s*(-?[0-9]+)/g)].map(m => parseInt(m[1], 10));\nif (!days.length) return true;                 // reading-based only: nothing parseable here\nconst anyLive = days.some(d => d > 0);\nreturn banner === anyLive;\n"
                },
                "type": "assertFromJavascript"
            }
        ]
    }
}