                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the panel",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "\u2b50 EMPTY STATE: the active Warranties panel names `Bypass Valve 0001` and shows `No Warranties Found...` \u2014 no warranty content",
                "noScreenshot": false,
                "params": {
                    "code": "\nconst tabEl = document.querySelector('[role=\"tab\"][data-active]');\nconst id = tabEl && tabEl.getAttribute('aria-controls');\nconst p = id ? document.getElementById(id) : null;\nif (!p || (tabEl.textContent || '').trim() !== 'Warranties') return false;\nconst t = p.textContent || '';\nreturn t.includes('Bypass Valve 0001') && t.includes('No Warranties Found...')\n  && !['Expiration Date', 'Remaining Days', 'Current Reading', 'Exp. Reading'].some(k => t.includes(k));\n"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "BANNER: absent on a work order with no warranty (paired with the empty state above)",
                "noScreenshot": false,
                "params": {
                    "code": "return !(document.body.textContent || '').includes('Assets Related to the Work Order are under Warranty');"
                },
                "type": "assertFromJavascript",
                "timeout": 10
            }
        ]
