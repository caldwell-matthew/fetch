                    "value": 2
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Test work order detail rendered",
                "noScreenshot": false,
                "params": {
                    "value": "Status:"
                },
                "type": "assertPageContains",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Open the \"Warranties\" tab",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work/EYRpYJ9QYdQ1JFF10JtB0Q",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[@role=\"tab\"][normalize-space(.)=\"Warranties\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "click"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the panel",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The \"Warranties\" tab is active",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work/EYRpYJ9QYdQ1JFF10JtB0Q",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[@role=\"tab\"][normalize-space(.)=\"Warranties\"][@data-active]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementPresent"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "PROOF: the panel rendered warranty content or its empty state, not a blank tab",
                "noScreenshot": false,
                "params": {
                    "code": "\nconst t = (document.body.textContent || '');\nreturn ['Expiration Date', 'Remaining Days', 'Current Reading', 'Exp. Reading']\n  .some(k => t.indexOf(k) !== -1);\n"
                },
                "type": "assertFromJavascript"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "BANNER: its presence agrees with whether a warranty is still active",
                "noScreenshot": false,
                "params": {
                    "code": "\nconst BANNER = 'Assets Related to the Work Order are under Warranty';\nconst t = document.body.innerText || '';\nconst banner = t.indexOf(BANNER) !== -1;\nconst hasAnyWarranty = ['Expiration Date', 'Exp. Reading', 'Remaining Days']\n    .some(k => t.indexOf(k) !== -1);\nif (!hasAnyWarranty) return !banner;          // no warranties at all -> no banner\nconst days = [...t.matchAll(/Remaining Days:?\\s*(-?[0-9]+)/g)].map(m => parseInt(m[1], 10));\nif (!days.length) return true;                 // reading-based only: nothing parseable here\nconst anyLive = days.some(d => d > 0);\nreturn banner === anyLive;\n"
                },
                "type": "assertFromJavascript"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to MOB.302's work order \u2014 its asset has no warranty",
                "noScreenshot": false,
                "params": {
                    "value": "https://dev.mentorapm.com/apm-mobile/work/RcdI0xcpc8NBV8VoRNNBYM"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
