{
    "test_name": "MOB.510_AssetVerify_Verify_Unverify",
    "details": {
        "name": "MOB.510_AssetVerify_Verify_Unverify",
        "type": "browser",
        "status": "paused",
        "message": "`MOB.510` Verify one asset, prove it moved tabs, then put it back.\n- SELF-RESTORING: verifies exactly ONE of the two assets and unverifies the same one,\n  so `Z0EVwQcdJZhMURcBFkp0E0` ends every run exactly as it started.\n- Deliberately does NOT verify both. Verifying every asset would flip the job to\n  COMPLETED, and `VerificationCheckbox` can never move a status back - unverifying\n  afterwards would leave a COMPLETED job holding unverified assets (bugs_found #10).\n- The unverify click targets the Verified tab, where exactly one row exists, so the\n  locator is unambiguous without needing to know the asset's name.\n- Asserts the counter and the tab contents, NOT the toast: the toast fires before the\n  mutation is sent and is never awaited (bugs_found #11).",
        "tags": [
            "Mobile",
            "env:dev",
            "Asset Verification",
            "CRUD"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "set_cookie": ""
        },
        "options": {
            "device_ids": [
                "chrome.tablet"
            ],
            "disable_cors": false,
            "disable_csp": false,
            "ignore_server_certificate_error": false,
            "min_failure_duration": 0,
            "min_location_failed": 1,
            "monitor_options": {},
            "no_screenshot": false,
            "retry": {
                "count": 1,
                "interval": 300.0
            },
            "rum_settings": {
                "is_enabled": false
            },
            "tick_every": 86400
        },
        "steps": [
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to the asset verification job list",
                "noScreenshot": false,
                "params": {
                    "value": "https://dev.mentorapm.com/apm-mobile/asset-verify"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the page to mount",
                "noScreenshot": false,
                "params": {
                    "value": 10
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Test the \"Mobile Jobs\" page mounted",
                "noScreenshot": false,
                "params": {
                    "check": "contains",
                    "value": "Mobile Jobs",
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-verify",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[@id=\"page-title\"]//h4[contains(normalize-space(.), \"Mobile Jobs\")]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementContent"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the lookup prefetch and batched detail downloads",
                "noScreenshot": false,
                "params": {
                    "value": 25
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Test the job list rendered",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-verify",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//input[@placeholder=\"Find Mobile Job(s)\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementPresent"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Test the lookup prefetch finished",
                "noScreenshot": false,
                "params": {
                    "value": "Fetching data for lookups"
                },
                "type": "assertPageLacks"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Test the batched job-detail downloads finished",
                "noScreenshot": false,
                "params": {
                    "value": "Fetching mobile job details"
                },
                "type": "assertPageLacks"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "FIXTURE GUARD: \"DATADOG MOBILE JOB\" is in this crew's list",
                "noScreenshot": false,
                "params": {
                    "value": "DATADOG MOBILE JOB"
                },
                "type": "assertPageContains"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to the fixture verification job",
                "noScreenshot": false,
                "params": {
                    "value": "https://dev.mentorapm.com/apm-mobile/asset-verify/Z0EVwQcdJZhMURcBFkp0E0"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the job detail to render",
                "noScreenshot": false,
                "params": {
                    "value": 5
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Switch to the \"All\" filter",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-verify/Z0EVwQcdJZhMURcBFkp0E0",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//label[.//span[normalize-space(.)=\"All\"]]"
                                }
                            ]
                        }
                    }
                },
                "type": "click"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the All list to re-render",
                "noScreenshot": false,
                "params": {
                    "value": 2
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "FIXTURE GUARD: job is at rest (\"0 out of 2 Assets Verified\")",
                "noScreenshot": false,
                "params": {
                    "value": "0 out of 2 Assets Verified"
                },
                "type": "assertPageContains"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Verify the first asset",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-verify/Z0EVwQcdJZhMURcBFkp0E0",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "(//input[@type=\"checkbox\"])[1]"
                                }
                            ]
                        }
                    }
                },
                "type": "click"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the verify mutation",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Test the counter incremented (\"1 out of 2 Assets Verified\")",
                "noScreenshot": false,
                "params": {
                    "value": "1 out of 2 Assets Verified"
                },
                "type": "assertPageContains"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Switch to the \"Verified\" filter",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-verify/Z0EVwQcdJZhMURcBFkp0E0",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//label[.//span[normalize-space(.)=\"Verified\"]]"
                                }
                            ]
                        }
                    }
                },
                "type": "click"
