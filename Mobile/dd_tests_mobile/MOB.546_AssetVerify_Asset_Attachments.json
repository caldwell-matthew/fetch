                "name": "RESTORED: the \"General Info\" tab is the selected one",
                "noScreenshot": false,
                "params": {
                    "code": "const sel = document.querySelector('[role=\"tab\"][aria-selected=\"true\"]');\nreturn !!sel && (sel.textContent || '').includes('General Info');"
                },
                "type": "assertFromJavascript",
                "timeout": 30
