                "params": {
                    "code": "let raw = null;\ntry { raw = sessionStorage.getItem('mobile-Asset-sort'); } catch (e) { return false; }\nif (!raw) return false;\nlet v = null;\ntry { v = JSON.parse(raw); } catch (e) { return false; }\nreturn !!v && v.id === 'name_ASC';"
