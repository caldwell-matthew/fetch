                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Remove the server read's sessionStorage keys",
                "noScreenshot": false,
                "params": {
                    "code": "['__dd511_job', '__dd511_job:inflight', '__dd511_job:at'].forEach(k => sessionStorage.removeItem(k));\nreturn true;"
                },
                "type": "assertFromJavascript",
                "timeout": 15
