{
    "test_name": "MOB.610_Collector_Search",
    "details": {
        "name": "MOB.610_Collector_Search",
        "type": "browser",
        "status": "paused",
        "message": "`MOB.610` The **Collector's asset search** (`AssetCollector/index.tsx`, `Find Asset(s)`) \u2014\na `SearchInput` nothing was proving.\n- **Data-independent by design.** The collected list grows every time `MOB.600` runs, so\n  no asset name can be relied on. Instead: guard that rows exist, prove a nonsense term\n  drives the count to ZERO, and prove clearing brings them back. That is the whole\n  filter contract without naming a record.\n- The row-count guard is what stops the negative being vacuous \u2014 on an empty list,\n  \"no rows match\" is true before anything is typed (trap 5).\n- **READ-ONLY** and self-restoring.",
        "tags": [
            "Mobile",
            "env:dev",
            "Collector",
            "Search",
            "read-only"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "set_cookie": ""
        },
        "options": {
            "device_ids": [
                "chrome.tablet"
            ],
            "disable_cors": false,
            "disable_csp": false,
            "ignore_server_certificate_error": false,
            "min_failure_duration": 0,
            "min_location_failed": 1,
            "monitor_options": {},
            "no_screenshot": false,
            "retry": {
                "count": 1,
                "interval": 300.0
            },
            "rum_settings": {
                "is_enabled": false
            },
            "tick_every": 86400
        },
        "steps": [
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to the collector",
                "noScreenshot": false,
                "params": {
                    "value": "https://dev.mentorapm.com/apm-mobile/asset-collector"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the page mount",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The Collector page rendered",
                "noScreenshot": false,
                "params": {
                    "check": "contains",
                    "value": "Collector",
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-collector",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[@id=\"page-title\"]//h4[contains(normalize-space(.), \"Collector\")]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementContent",
                "timeout": 60
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Its search box renders",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-collector",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//input[@placeholder=\"Find Asset(s)\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementPresent",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "BASELINE GUARD: the collected list has rows to filter",
                "noScreenshot": false,
                "params": {
                    "code": "const rows = () => [...document.querySelectorAll('.mantine-Accordion-item')];\nreturn rows().length >= 1;"
                },
                "type": "assertFromJavascript",
                "timeout": 60
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Focus the search box (a term nothing can match)",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-collector",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//input[@placeholder=\"Find Asset(s)\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "click",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Select any existing term (typeText APPENDS \u2014 trap 17)",
                "noScreenshot": false,
                "params": {
                    "value": "a",
                    "modifiers": [
                        "Control"
                    ]
                },
                "type": "pressKey"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Type a term nothing can match",
                "noScreenshot": false,
                "params": {
                    "value": "ZZQQXX-NO-SUCH-THING",
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-collector",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//input[@placeholder=\"Find Asset(s)\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "typeText"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the filter apply",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "NEGATIVE: the filter drives the row count to ZERO",
                "noScreenshot": false,
                "params": {
                    "code": "const rows = () => [...document.querySelectorAll('.mantine-Accordion-item')];\nreturn rows().length === 0;"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Focus the search box (to clear it)",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/asset-collector",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//input[@placeholder=\"Find Asset(s)\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "click",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Select all",
                "noScreenshot": false,
                "params": {
                    "value": "a",
                    "modifiers": [
                        "Control"
                    ]
                },
                "type": "pressKey"
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Delete \u2014 leave the filter as we found it",
                "noScreenshot": false,
                "params": {
                    "value": "Delete"
                },
                "type": "pressKey"
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the list restore",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "RESTORED: clearing brings the rows back",
                "noScreenshot": false,
                "params": {
                    "code": "const rows = () => [...document.querySelectorAll('.mantine-Accordion-item')];\nreturn rows().length >= 1;"
                },
                "type": "assertFromJavascript",
                "timeout": 60
            }
        ]
    }
}