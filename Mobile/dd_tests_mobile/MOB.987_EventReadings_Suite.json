{
    "test_name": "MOB.987_EventReadings_Suite",
    "details": {
        "name": "MOB.987_EventReadings_Suite",
        "type": "browser",
        "status": "paused",
        "message": "Event readings \u2014 meter capture on an asset.\n- \u26a0\ufe0f **LEAVES RESIDUE**: one `Event` record per leg, per run, and mobile is delete-free.\n- Kept OUT of `MOB.993_AssetVerify_Suite` on purpose: that suite is documented as\n  self-restoring, and adding this child would make that promise false.\n- **The first ever run FAILS its opening assertion by design** \u2014 that assertion proves\n  the server returned a reading written by a PREVIOUS run, and on run one there is none.\n- subtestPublicId values stay PENDING-WIRE-UP until the children exist on Datadog;\n  run wire_suite.py after pushing them.",
        "tags": [
            "Mobile",
            "env:dev",
            "Asset Verification",
            "residue",
            "suite"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                },
                {
                    "id": "87b53e00-1675-4aa6-82c3-6e328e007d4b",
                    "name": "DATA_DOG_EMAIL",
                    "type": "global"
                },
                {
                    "id": "9c503d08-e175-464a-aa8e-dc9c0087ce30",
                    "name": "DATA_DOG_PASSWORD",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
