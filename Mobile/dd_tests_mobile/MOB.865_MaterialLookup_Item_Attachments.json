                    }
                },
                "type": "assertElementPresent",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "AVATAR: click the row's image button IF it exists, and record which branch this is",
                "noScreenshot": false,
                "params": {
                    "code": "const row = [...document.querySelectorAll('tr')]\n  .find(r => (r.textContent || '').includes('000-000-000 Adamantium'));\nif (!row) return false;\nconst b = [...row.querySelectorAll('button')]\n  .find(x => /^View .+ image$/.test(x.getAttribute('aria-label') || ''));\nsessionStorage.setItem('__dd865_avatar', b ? 'button' : 'none');\nif (b) b.click();\nreturn true;"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the image modal open, if there was a button",
                "noScreenshot": false,
                "params": {
                    "value": 2
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "\u2b50 AVATAR: EXACTLY ONE of \u2014 no image button on the row, or an open modal showing `img.file-image`",
                "noScreenshot": false,
                "params": {
                    "code": "const branch = sessionStorage.getItem('__dd865_avatar');\nconst m = document.querySelector('.mantine-Modal-content');\nconst img = m ? m.querySelector('img.file-image') : null;\nconst opened = !!m && !!img;\nif (branch === 'none') return !opened;\nif (branch === 'button') return opened;\nreturn false;"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Close the image modal (a no-op when it never opened)",
                "noScreenshot": false,
                "params": {
                    "value": "Escape"
                },
                "type": "pressKey"
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
