                                    "value": "//tr[contains(normalize-space(.), \"000-000-000 Adamantium\")]//button[.//*[@data-icon=\"arrow-up-right-from-square\" or contains(concat(\" \", normalize-space(@class), \" \"), \" fa-arrow-up-right-from-square \")]]"
                                }
                            ]
                        }
                    }
                },
                "type": "click",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
