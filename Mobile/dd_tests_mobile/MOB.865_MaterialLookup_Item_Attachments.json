                    "code": "const m = document.querySelector('.mantine-Modal-content');\nif (!m) return false;\nconst t = [...m.querySelectorAll('button')].map(b => (b.textContent || '').trim());\nreturn t.includes('Add Photo') && !t.includes('Add File');"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": true,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": false,
                "name": "\ud83d\udcca REPORT: does the fixture item have photos? (a carousel is present) \u2014 informational",
                "noScreenshot": false,
                "params": {
                    "code": "const m = document.querySelector('.mantine-Modal-content');\nif (!m) return false;\nreturn !!m.querySelector('[class*=\"mantine-Carousel\"]');"
                },
