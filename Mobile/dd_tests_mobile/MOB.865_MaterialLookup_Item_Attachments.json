            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "RESTORED: no modal is left open for the next subtest",
                "noScreenshot": false,
                "params": {
                    "code": "return !document.querySelector('.mantine-Modal-content');"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            }
        ]
    }
