                "name": "The \"Photos\" segment is the CHECKED one",
                "noScreenshot": false,
                "params": {
                    "code": "const m = document.querySelector('.mantine-Modal-content');\nif (!m) return false;\nconst root = m.querySelector('[class*=\"mantine-SegmentedControl-root\"]');\nif (!root) return false;\nconst on = root.querySelector('input[type=\"radio\"]:checked');\nreturn !!on && on.value === '3';"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
