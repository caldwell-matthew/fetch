                "isCritical": true,
                "name": "FIXTURE GUARD: \"000-000-000 Adamantium\" is listed",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/material-lookup",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
