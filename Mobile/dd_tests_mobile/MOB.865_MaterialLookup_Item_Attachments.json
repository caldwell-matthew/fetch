            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The modal opened on the Quantity Adjustment view",
                "noScreenshot": false,
                "params": {
                    "value": "Current Quantity"
                },
                "type": "assertPageContains",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "\u2b50 SEGMENTS: exactly Quantity Adjustment \u00b7 Stock Item \u00b7 Photos \u00b7 Docs \u2014 values 1..4, in order",
                "noScreenshot": false,
                "params": {
                    "code": "const m = document.querySelector('.mantine-Modal-content');\nif (!m) return false;\nconst root = m.querySelector('[class*=\"mantine-SegmentedControl-root\"]');\nif (!root) return false;\nconst vals = [...root.querySelectorAll('input[type=\"radio\"]')].map(i => i.value);\nconst labels = [...root.querySelectorAll('label')].map(l => (l.textContent || '').trim());\nconst wantV = ['1', '2', '3', '4'];\nconst wantL = ['Quantity Adjustment', 'Stock Item', 'Photos', 'Docs'];\nreturn JSON.stringify(vals) === JSON.stringify(wantV)\n    && JSON.stringify(labels) === JSON.stringify(wantL);"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Switch to the \"Photos\" segment by VALUE (3) \u2014 never by text (\u00a722)",
                "noScreenshot": false,
                "params": {
                    "code": "const m = document.querySelector('.mantine-Modal-content');\nif (!m) return false;\nconst root = m.querySelector('[class*=\"mantine-SegmentedControl-root\"]');\nif (!root) return false;\nconst el = root.querySelector('input[type=\"radio\"][value=\"3\"]');\nif (!el) return false;\nel.click();\nreturn true;"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the Photos panel mount (its attachment query fires now)",
                "noScreenshot": false,
