                "name": "\u2b50 OPEN: the `Select a map` modal holds the STORED map, by id, and names it",
                "noScreenshot": false,
                "params": {
                    "code": "const m = [...document.querySelectorAll('[class*=\"mantine-Modal-content\"]')]\n  .find(x => (x.textContent || '').includes('Select a map'));\nif (!m) return false;\nconst hidden = m.querySelector('input[type=\"hidden\"]');\nconst shown = m.querySelector('input:not([type=\"hidden\"])');\nreturn !!window.__ddMapBefore && !!hidden && hidden.value === window.__ddMapBefore\n  && !!shown && shown.value.trim().length > 0;"
                },
                "type": "assertFromJavascript",
                "timeout": 30
