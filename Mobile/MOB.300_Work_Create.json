{
    "test_name": "MOB.300_Work_Create",
    "details": {
        "name": "MOB.300_Work_Create",
        "type": "browser",
        "status": "paused",
        "message": "`MOB.300` Create a work order from mobile.\n- Tags the record's Problem Description with 'DD SYNTHETIC MOBILE' so synthetic data is findable.\n- MUTATES: creates a real work order on dev. Mobile has no delete for work orders,\n  so these accumulate and must be cleaned up from the desktop app.\n- The create button is hidden when offline or without work.create permission.",
        "tags": [
            "Mobile",
            "env:dev",
            "Work Order",
            "CRUD",
            "E2E"
        ],
        "locations": [
            "gcp:us-west2"
        ],
        "config": {
            "assertions": [],
            "config_variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "request": {
                "headers": {},
                "method": "GET",
                "url": "{{ MOBDEV }}"
            },
            "variables": [
                {
                    "id": "fe7958bf-435f-4932-af8e-0931caab79e7",
                    "name": "MOBDEV",
                    "type": "global"
                }
            ],
            "set_cookie": ""
        },
        "options": {
            "device_ids": [
                "chrome.tablet"
            ],
            "disable_cors": false,
            "disable_csp": false,
            "ignore_server_certificate_error": false,
            "min_failure_duration": 0,
            "min_location_failed": 1,
            "monitor_options": {},
            "no_screenshot": false,
            "retry": {
                "count": 1,
                "interval": 300.0
            },
            "rum_settings": {
                "is_enabled": false
            },
            "tick_every": 86400
        },
        "steps": [
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to /work",
                "noScreenshot": false,
                "params": {
                    "value": "https://dev.mentorapm.com/apm-mobile/work"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Test page title \"Work Orders\"",
                "noScreenshot": false,
                "params": {
                    "check": "contains",
                    "value": "Work Orders",
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[@id=\"page-title\"]//h4[contains(normalize-space(.), \"Work Orders\")]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementContent"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Open the create-work-order form",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//div[contains(concat(\" \", normalize-space(@class), \" \"), \" mantine-Affix-root \")]//button"
                                }
                            ]
                        }
                    }
                },
                "type": "click"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Test create modal opened",
                "noScreenshot": false,
                "params": {
                    "value": "Creating New Work Order"
                },
                "type": "assertPageContains"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Focus the Workflow lookup",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[@id=\"workflowTitleId\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "click"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Search for the Datadog Test workflow",
                "noScreenshot": false,
                "params": {
                    "value": "Datadog Test",
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[@id=\"workflowTitleId\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "typeText"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Pick the \"Datadog Test\" workflow",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[@role=\"option\"][contains(normalize-space(.), \"Datadog Test\")]"
                                }
                            ]
                        }
                    }
                },
                "type": "click"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Type the synthetic marker into Problem Description",
                "noScreenshot": false,
                "params": {
                    "value": "DD SYNTHETIC MOBILE",
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[@id=\"problemDesc\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "typeText"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Click \"Create Work Order\"",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//button[normalize-space(.)=\"Create Work Order\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "click"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Wait for the create mutation to resolve",
                "noScreenshot": false,
                "params": {
                    "value": 3
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Test success toast",
                "noScreenshot": false,
                "params": {
                    "value": "Work order successfully created!"
                },
                "type": "assertPageContains"
            }
        ]
    }
}