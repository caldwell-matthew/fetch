                "exitIfSucceed": false,
                "isCritical": true,
                "name": "LOADEDALL 3/3: the per-stage detail downloads finished",
                "noScreenshot": false,
                "params": {
                    "value": "workstages downloaded"
                },
                "type": "assertPageLacks",
                "timeout": 360
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "LOADEDALL: start the idle clock",
                "noScreenshot": false,
                "params": {
                    "code": "sessionStorage.removeItem('__dd_worklist_idle_since');\nreturn true;"
                },
                "type": "assertFromJavascript"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "LOADEDALL: no loading bar on screen for 10s straight (all six phases, and the gaps between them)",
                "noScreenshot": false,
                "params": {
                    "code": "const K = '__dd_worklist_idle_since';\nif (document.querySelector('.mantine-Progress-root')) {\n  sessionStorage.removeItem(K);\n  return false;\n}\nconst since = Number(sessionStorage.getItem(K)) || 0;\nif (!since) { sessionStorage.setItem(K, String(Date.now())); return false; }\nreturn Date.now() - since >= 10000;"
                },
                "type": "assertFromJavascript",
                "timeout": 360
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Navigate to the fixture work order",
                "noScreenshot": false,
                "params": {
                    "value": "https://dev.mentorapm.com/apm-mobile/work/EYRpYJ9QYdQ1JFF10JtB0Q"
                },
                "type": "goToUrl"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Let the detail view begin rendering",
                "noScreenshot": false,
                "params": {
                    "value": 2
                },
                "type": "wait"
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Test work order detail rendered",
                "noScreenshot": false,
                "params": {
                    "value": "Status:"
                },
                "type": "assertPageContains",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Open the \"General Info\" tab",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work/EYRpYJ9QYdQ1JFF10JtB0Q",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[@role=\"tab\"][normalize-space(.)=\"General Info\"]"
                                }
                            ]
                        }
                    }
                },
                "type": "click",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "\"General Info\" is the active tab",
                "noScreenshot": false,
                "params": {
                    "element": {
                        "url": "https://dev.mentorapm.com/apm-mobile/work/EYRpYJ9QYdQ1JFF10JtB0Q",
                        "userLocator": {
                            "failTestOnCannotLocate": true,
                            "values": [
                                {
                                    "type": "xpath",
                                    "value": "//*[@role=\"tab\"][normalize-space(.)=\"General Info\"][@data-active]"
                                }
                            ]
                        }
                    }
                },
                "type": "assertElementPresent",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "PREMISE: the form shows Stage Notes (`#desc`) = `DATADOG FIXTURE` and an empty Problem Description (`#problemDesc`) \u2014 the two multiline fields",
                "noScreenshot": false,
                "params": {
                    "code": "const d = document.getElementById('desc'), p = document.getElementById('problemDesc');\nreturn !!document.getElementById('mobile-genInfo') && !!d && d.value === 'DATADOG FIXTURE' && !!p && !p.value;"
                },
                "type": "assertFromJavascript",
                "timeout": 45
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "\u2b50 The value arrow renders beside Stage Notes (it holds a value) and NOT beside Problem Description (empty) \u2014 `MultiLineLabel` returns nothing for an empty value",
                "noScreenshot": false,
                "params": {
                    "code": "const field = id => {\n  const i = document.getElementById(id);\n  return i && i.closest('.form-group');\n};\nconst arrow = w => w && w.querySelector('svg[data-icon=\"square-arrow-up-right\"]');\nreturn !!arrow(field('desc')) && !!field('problemDesc') && !arrow(field('problemDesc'));"
                },
                "type": "assertFromJavascript",
                "timeout": 30
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Click Stage Notes' arrow \u2014 dispatched on the ICON, which carries the onClick (its ActionIcon's `aria-label` is `Settings` and does nothing)",
                "noScreenshot": false,
                "params": {
                    "code": "const field = id => {\n  const i = document.getElementById(id);\n  return i && i.closest('.form-group');\n};\nconst arrow = w => w && w.querySelector('svg[data-icon=\"square-arrow-up-right\"]');\nconst a = arrow(field('desc'));\nif (!a) return false;\na.dispatchEvent(new MouseEvent('click', { bubbles: true }));\nreturn true;"
                },
                "type": "assertFromJavascript",
                "timeout": 20
            },
            {
                "allowFailure": false,
                "alwaysExecute": false,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "\u2b50 A modal opened showing the field's VALUE \u2014 exactly `DATADOG FIXTURE` (not its label `Stage Notes`)",
                "noScreenshot": false,
                "params": {
                    "code": "const m = [...document.querySelectorAll('.mantine-Modal-content')]\n  .find(x => ((x.querySelector('.mantine-Modal-body') || {}).textContent || '').trim() === 'DATADOG FIXTURE');\nreturn !!m;"
                },
                "type": "assertFromJavascript",
                "timeout": 20
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "Close it with its own close button",
                "noScreenshot": false,
                "params": {
                    "code": "const m = [...document.querySelectorAll('.mantine-Modal-content')]\n  .find(x => ((x.querySelector('.mantine-Modal-body') || {}).textContent || '').trim() === 'DATADOG FIXTURE');\nconst c = m && m.querySelector('.mantine-Modal-close');\nif (!c) return false;\nc.click();\nreturn true;"
                },
                "type": "assertFromJavascript",
                "timeout": 20
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "The value modal is gone",
                "noScreenshot": false,
                "params": {
                    "code": "const m = [...document.querySelectorAll('.mantine-Modal-content')]\n  .find(x => ((x.querySelector('.mantine-Modal-body') || {}).textContent || '').trim() === 'DATADOG FIXTURE');\nreturn !m;"
                },
                "type": "assertFromJavascript",
                "timeout": 20
            },
            {
                "allowFailure": false,
                "alwaysExecute": true,
                "exitIfSucceed": false,
                "isCritical": true,
                "name": "RESTORED: the form is untouched \u2014 Stage Notes still `DATADOG FIXTURE`, nothing typed",
                "noScreenshot": false,
                "params": {
                    "code": "const d = document.getElementById('desc');\nreturn !!d && d.value === 'DATADOG FIXTURE';"
                },
                "type": "assertFromJavascript",
                "timeout": 20
            }
        ]
    }
